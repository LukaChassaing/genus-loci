// Sessile oak, Quercus petraea (Matt.) Liebl.
// Starting point: quercus_robur.ron, which this species shares most data with (Atlas, EUFORGEN:
// both oaks are reported together). References: data/validation/quercus_petraea.ron (40 entries),
// trait sheet docs/species/quercus_petraea.md.
// Fields written without a comment keep the quercus_robur.ron pilot value (status: proxy /
// stylised, not re-tuned for this species). Statuses used in comments: measured [reference id of
// data/validation/<id>.ron], proxy (another species, named), estimated (general knowledge, no
// source read), calibrated (tuned so the simulated tree matches the references). Rendering fields
// (bark, leaf shape, colours) are calibrated by eye.
// Growth (height and diameter against age) is NOT re-fitted for sessile oak: no age-resolved
// sessile reference exists in the file; the Q. robur calibration on White 1998 (open-grown common
// oak) is kept as a proxy. Differences from the pilot are limited to what the sheet documents: a
// more dominant main axis and a tighter crown, fewer epicormic shoots, later budburst, deeper
// taproot, higher drought and lower waterlogging tolerance.
// Known gaps of the engine: lammas (second) flush and the polycyclic growth of oaks are not
// represented (as in the pilot); sessile acorns are sessile (no peduncle), which is not drawn
// (acorns are not drawn at all).
(
    species: "Quercus petraea",
    common_name: "Sessile oak",
    common_name_fr: "Chêne sessile",
    category: Broadleaf,
    // Unlike the pedunculate oak, the sessile keeps a dominant main stem, a tighter crown and
    // decreasing branching (Atlas, in docs/species/quercus_petraea.md); straighter bole, fewer
    // epicormic shoots (usual judgement, not quantified). Architectural model not verified.
    // Everything not commented keeps the Q. robur value.
    architecture: (
        apical_dominance_young: 0.75,
        // estimated: more persistent leader than Q. robur (0.42), still decurrent when old
        // (docs/species/quercus_petraea.md: "fût principal dominant").
        apical_dominance_mature: 0.48,
        maturity_age_years: 50.0,
        apical_dominance_branches: 0.52,
        juvenile_phase_years: 15.0,
        // estimated: scaffold limbs less dominant than in Q. robur (3.0), tighter crown.
        lateral_competition: 2.4,
        vigour_per_light: 5.7,
        bud_break_threshold: 1.0,
        internode_length_m: 0.045,
        max_shoot_length_m: 0.5,
        lateral_buds_per_shoot: 4,
        lateral_buds_per_metamer: 0.4,
        bud_lifetime_years: 3,
        branching_angle_deg: 52.0,
        phyllotaxis_deg: 144.0,
        max_order: 120,
        gravitropism: 0.35,
        lateral_gravitropism: 0.3,
        limb_setpoint_low_deg: 60.0,
        limb_setpoint_high_deg: 30.0,
        twig_setpoint_deg: 65.0,
        // estimated: crown narrower than Q. robur (1.15) [docs/species/quercus_petraea.md].
        crown_spread_ratio: 1.0,
        phototropism: 0.12,
        // estimated: straighter than Q. robur (8).
        sinuosity_deg: 6.0,
        // estimated: fewer elbows and relays than Q. robur (0.25), straighter bole.
        leader_loss_probability: 0.15,
        leader_loss_angle_deg: 22.0,
        sag_coefficient: 3.0,
        sag_min_radius_mm: 40.0,
        sag_max_deg_per_year: 0.4,
        sag_max_total_deg: 8.0,
        sag_max_droop_deg: 10.0,
        sag_min_inclination_deg: 50.0,
        straightening_deg_per_year: 1.5,
        straightening_keep_deg: 12.0,
        straightening_min_radius_mm: 40.0,
        shedding_threshold: 0.09,
        shade_survival_years: 3,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.15,
        clear_bole_max_m: 4.0,
        clear_bole_limb_ratio: 0.5,
        retrenchment_onset_years: 200.0,
        retrenchment_rate: 0.08,
        retrenchment_ramp_years: 100.0,
        retrenchment_reach: 0.72,
        // estimated: fewer epicormics than Q. robur (0.04).
        epicormic_rate: 0.025,
        hydraulic_path_max_m: 37.0,
        hydraulic_exponent: 1.8,
        hydraulic_foliage_exponent: 1.2,
    ),
    // Sessile oak leaf: petiolate (1-2.5 cm), obovate, 5-8 lobes per side, 7-12 cm long (general
    // knowledge, no source read).
    leaf: (
        // estimated.
        length_cm: 11.0,
        // estimated.
        width_cm: 6.0,
        // estimated (shallower lobes than Q. robur).
        lobes: 8,
        serration: 0.0,
        deciduous: true,
        // estimated: young trees keep dead leaves; existence noted in
        // docs/species/quercus_petraea.md ("existe, non chiffrée"), fraction not measured.
        marcescence: 0.5,
        marcescence_max_age_years: 30.0,
        leaves_per_shoot: 7.0,
        cluster_size_leaves: 3.0,
        foliage_density: 5.0,
        tip_bunching: 0.75,
        // estimated: leaves are petiolate in the sessile oak (Q. robur: very short petiole).
        petiole_ratio: 0.18,
        leaf_droop: 0.15,
        spur_foliage: 4.0,
        spur_max_radius_mm: 40.0,
        spur_min_light: 0.05,
        colour_spread: 0.55,
    ),
    pigments: (
        chlorophyll: 1.0,
        carotenoids: 0.55,
        anthocyanins: 0.12,
        tannins: 0.9,
    ),
    // Budburst doy 101 [ren_budburst] (Q. robur 100 in the same network), 115-125 for both oaks
    // [atlas_budburst]; end of yellowing doy 299 [ren_yellow]. Sessile oak has the strongest
    // thermal sensitivity of budburst, -7.5 d/degC (Vitasse 2009, abstract) [vitasse_trend gives
    // -0.42 d/yr at Fontainebleau]: not used for calibration.
    phenology: (
        chilling_requirement_days: 45.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        // calibrated: a few days later than Q. robur (308), as in the RENECOFOR series
        // [ren_budburst 101 vs robur 100], and within [atlas_budburst].
        gdd_budburst: 312.0,
        chill_forcing_gdd: 130.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 190.0,
        // calibrated on [ren_yellow 299]; same as the oak pilot.
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 17.0,
        // calibrated on [ren_yellow 299].
        senescence_cdd: 100.0,
        leaf_fall_days: 21.0,
    ),
    // Density: dry wood 650 kg/m3 (390-930) [wpd_density]. Growth coefficient kept from Q. robur
    // (see header).
    wood: (
        // measured [wpd_density] (dry wood).
        density_kg_m3: 650.0,
        // proxy: Q. robur (dry MOE 13.3 GPa at 12 % [wpf_moe12]).
        elasticity_gpa: 9.0,
        ring_porous: true,
        earlywood_share: 0.35,
        ring_contrast: 1.0,
        snag_years_per_m: 500.0,
        // proxy: Q. robur calibration on White 1998 (open-grown common oak). Not re-fitted: no age-
        // resolved sessile data.
        growth_coefficient: 0.00038,
        twig_radius_mm: 2.5,
        max_ring_width_mm: 9.0,
        collar_flare: 0.25,
        pipe_exponent: 2.3,
        limb_draw_boost: 1.6,
        bark_irregularity: 0.07,
        adaptive_stress_mpa: 11.1,
        adaptive_min_diameter_cm: 5.0,
        adaptive_max_budget_share: 0.3,
        root_flare: 0.7,
        root_flare_height_radii: 2.5,
        buttress_lobes: 5,
    ),
    bark: (
        color: (0.40, 0.32, 0.28),
        young_color: (0.40, 0.38, 0.22),
        old_darkening: (0.10, 0.08, 0.06),
        lenticels: 0.0,
        fissures: 0.85,
        gloss: 0.0,
    ),
    // Deep penetrating taproot, more developed than in Q. robur [atlas_taproot]; less tolerant of
    // waterlogging [niinemets_waterlogging 1.2/5].
    roots: (
        // estimated: taproot more developed than Q. robur (0.9) [atlas_taproot].
        taproot_dominance: 0.95,
        // estimated: the taproot persists longer.
        taproot_decline_years: 18.0,
        // estimated: deeper than Q. robur (4.5) [atlas_taproot]; no depth value in the references.
        max_depth_m: 5.0,
        lateral_spread: 1.4,
        lateral_count: 8,
        lateral_depth_m: 0.45,
        sinker_tendency: 0.25,
        branching_probability: 0.3,
        max_order: 3,
        annual_extension_m: 0.9,
        max_penetration_mpa: 3.2,
        // measured [niinemets_waterlogging 1.2/5], scale x/5 (Q. robur 0.4); < 0.3 triggers the
        // bench rule "growth on gley clay".
        waterlogging_tolerance: 0.24,
        // estimated: less tolerant than Q. robur (0.0), which Parelle et al. 2006 compared with Q.
        // petraea.
        hypoxia_sensitivity: 0.4,
        drought_deepening: 0.6,
        hydrotropism: 0.4,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.8,
        fine_root_per_m: 1000.0,
        rapid_taper: 1.2,
    ),
    // Scale 0-1 = Niinemets & Valladares rating / 5 (bench convention).
    tolerances: (
        frost_c: -3.0,
        // measured [niinemets_drought 3.02/5]; more drought-tolerant than Q. robur [atlas_drought].
        drought: 0.6,
        // measured [niinemets_shade 2.73/5]; half-shade, better than Q. robur, less than beech
        // [wpf_shade].
        shade: 0.55,
    ),
    // First fruiting 40-100 years [eu_seed_age], 40-50 [wpp_fruit_age, Poland], 60 [wpf_fruit_age,
    // France]; flowering mid-May [wpf_flowering 135, estimated by the source].
    reproduction: (
        // measured [wpp_fruit_age 40-50, eu_seed_age 40-100]; [wpf_fruit_age] says 60. Divergent
        // sources, middle of the overlap.
        first_flowering_age_years: 45.0,
        flower_display: 0.0,
        fruit_display: 0.0,
        // calibrated: catkins open with the leaves, a little later than Q. robur; [wpf_flowering]
        // gives doy 135 (estimated by that source).
        bloom_gdd: 330.0,
        bloom_duration_gdd: 120.0,
        min_wood_age_years: 0,
        min_light: 0.3,
        max_wood_radius_mm: 30.0,
        flower_density: 1.0,
        flower_cluster_cm: 6.0,
        fruit_cluster_cm: 3.0,
        flower_color: (0.65, 0.62, 0.30),
        fruit_set: 0.3,
        // proxy: Q. robur.
        flower_frost_c: -2.5,
        fruit_ripening_days: 140.0,
        fruit_persistence_days: 20.0,
        fruit_color_unripe: (0.35, 0.45, 0.15),
        fruit_color_ripe: (0.45, 0.32, 0.15),
        // acorn (drawn as a round fruit; display is 0 in the pilot as well).
        fruit_kind: Nut,
        // acorn 1.5-5 g [wpp_acorn_mass] (middle).
        fruit_mass_g: 3.0,
        // estimated: oak masting every few years (the file has no sessile mast interval; Q. robur
        // entries exist in quercus_robur.ron).
        crop_interval_years: 4.0,
        // default.
        off_year_crop: 0.15,
    ),
    // 600-1000 years [wpf_longevity], 800+ [eu_longevity, wpd_longevity], > 1000 [atlas_longevity].
    // No programmed decline.
    longevity: (
        decline_onset_years: 0.0,
        decline_years: 50.0,
        decline_min_vigour: 0.3,
    ),
    symbiosis: (
        mycorrhiza: Ecto,
        carbon_cost: 0.15,
        phosphorus_share: 0.6,
        nitrogen_share: 0.4,
        water_share: 0.05,
        hyphal_reach_m: 0.35,
    ),
    // Good resprouting, coppices and pollards easily [atlas_resprout]; fewer epicormics than Q.
    // robur. Calibrations chosen for these qualitative rankings.
    pruning: (
        // estimated: lower than Q. robur (0.9).
        epicormic_potential: 0.6,
        sprout_vigour: 2.2,
        // estimated from [atlas_resprout] ("good").
        stump_sprouting: 0.8,
        root_suckering: 0.0,
        compensatory_growth: 0.35,
        woundwood_ratio: 2.2,
        compartmentalization: 0.7,
        decay_infection_rate: 0.04,
        decay_axial_m_per_year: 0.06,
        decay_radial_mm_per_year: 5.0,
        pathogen_dormant_risk: 0.03,
        pathogen_summer_risk: 0.02,
        pathogen_dieback_years: 4.0,
        reserve_in_branches: 0.3,
        root_balance_rate: 0.3,
        sap_bleeding: 0.05,
        // measured [eu_longevity 800+, wpd_longevity 800-1000, wpf_longevity 600-1000]; the bench
        // simulates 400 years at most.
        typical_lifespan_years: 800.0,
    ),
    mechanics: (
        // estimated: the Q. robur proxy (USDA Wood Handbook white oak, green) scaled by the ratio
        // of basal densities (650/640); no green-wood table for this species was read. Sessile oak:
        // dry density from [wpd_density]; Q. robur proxy values otherwise.
        green_density_kg_m3: 1042.0,
        // estimated, same scaling as green_density_kg_m3 (the dry-wood MOR of the reference file is
        // a 12 % value, not a green one).
        green_mor_mpa: 57.9,
        // estimated, same scaling as green_density_kg_m3.
        green_moe_gpa: 8.7,
        // estimated, as the Q. robur pilot (Vollsinger et al. 2005 range for three hardwoods; this
        // species not measured).
        crown_drag_coefficient: 0.2,
        // estimated, as the Q. robur pilot.
        vogel_exponent: -1.0,
        // estimated: Sitka spruce Creg of ForestGALES used as in the Q. robur pilot; no broadleaf
        // tree-pulling coefficient found (docs/sources.md, Ecarts connus). Not valid for a shallow
        // root plate.
        anchorage_nm_per_kg: 178.1,
    ),
)
