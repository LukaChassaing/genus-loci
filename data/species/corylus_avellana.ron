// Common hazel, Corylus avellana L. Fruit tree of the registry (nut crop),
// derived from the Malus pilot for the file structure.
//
// WHAT IS SIMULATED: ONE SINGLE STEM ("brin") of a hazel, own-rooted. The
// real hazel is a multi-stemmed stool of 10-12 stems [fr_wiki_stool] with a
// short-lived stem (60-90 y [atlas_lifespan] [fls_lifespan]) and a longer-lived
// stool; the engine simulates exactly one trunk. Honest consequences, to be
// reported as an engine gap: no stool, no stem renewal by basal sprouts
// (only the coppice cut works: stump_sprouting), no stem count; the
// stem is read as one stem of the stool (typical lifespan 70 y = a stem, not
// the stool). Heights are those of the stool [atlas_height] [de_wiki_height].
// Ectomycorrhizal [de_wiki_mycorrhiza] [en_wiki_mycorrhiza]: this IS
// representable (mycorrhiza: Ecto).
//
// Values not backed by an entry carry the marker "proxy Malus domestica
// pilot, estimated". Reference values: data/validation/corylus_avellana.ron
// (ids in brackets) and docs/species/corylus_avellana.md.
(
    species: "Corylus avellana",
    common_name: "Common hazel",
    common_name_fr: "Noisetier",
    category: FruitTree, // proxy Malus domestica pilot, estimated
    architecture: (
        // Weak apical dominance, vigorous basal shoots [atlas_sprout]
        // (qualitative); sympodial branching (trait sheet). A short excurrent youth is
        // kept on purpose (DBH read at 1.3 m, see the guide); values estimated.
        apical_dominance_young: 0.62,
        apical_dominance_mature: 0.36,
        maturity_age_years: 25.0,
        juvenile_phase_years: 8.0,
        apical_dominance_branches: 0.5, // proxy Malus domestica pilot, estimated
        lateral_competition: 1.8, // proxy Malus domestica pilot, estimated
        // Calibrated: stool 4-8 m [atlas_height], 3-8 m [en_wiki_height], 5-6 m
        // [de_wiki_height], 2-5 m [fr_wiki_height]; exceptionally 12-15 m [wt_height]
        // [en_wiki_height_max].
        vigour_per_light: 5.5,
        bud_break_threshold: 1.0, // proxy Malus domestica pilot, estimated
        internode_length_m: 0.04,
        // Calibrated: stool shoots of several metres in the first year after cutting
        // (trait sheet) imply long annual shoots.
        max_shoot_length_m: 0.9,
        lateral_buds_per_shoot: 5, // proxy Malus domestica pilot, estimated
        lateral_buds_per_metamer: 0.3, // proxy Malus domestica pilot, estimated
        bud_lifetime_years: 4, // proxy Malus domestica pilot, estimated
        branching_angle_deg: 45.0,
        // Corylus leaves are distichous (two ranks); 180 degrees makes the engine draw
        // flat tiers like a conifer, so a spiral divergence is used (engine approximation).
        phyllotaxis_deg: 137.5,
        max_order: 120, // proxy Malus domestica pilot, estimated
        gravitropism: 0.45, // proxy Malus domestica pilot, estimated
        lateral_gravitropism: 0.3, // proxy Malus domestica pilot, estimated
        limb_setpoint_low_deg: 70.0, // proxy Malus domestica pilot, estimated
        limb_setpoint_high_deg: 50.0, // proxy Malus domestica pilot, estimated
        twig_setpoint_deg: 70.0, // proxy Malus domestica pilot, estimated
        // Rounded understorey crown (estimated).
        crown_spread_ratio: 1.2,
        phototropism: 0.12, // proxy Malus domestica pilot, estimated
        sinuosity_deg: 9.0, // proxy Malus domestica pilot, estimated
        leader_loss_probability: 0.1,
        leader_loss_angle_deg: 30.0, // proxy Malus domestica pilot, estimated
        sag_coefficient: 5.0, // proxy Malus domestica pilot, estimated
        sag_min_radius_mm: 25.0, // proxy Malus domestica pilot, estimated
        sag_max_deg_per_year: 0.8, // proxy Malus domestica pilot, estimated
        sag_max_total_deg: 14.0, // proxy Malus domestica pilot, estimated
        sag_max_droop_deg: 15.0, // proxy Malus domestica pilot, estimated
        sag_min_inclination_deg: 45.0, // proxy Malus domestica pilot, estimated
        straightening_deg_per_year: 1.0, // proxy Malus domestica pilot, estimated
        straightening_keep_deg: 10.0, // proxy Malus domestica pilot, estimated
        straightening_min_radius_mm: 30.0, // proxy Malus domestica pilot, estimated
        // Grows in full light as in shade [atlas_leaf] (qualitative): tolerant, estimated.
        shedding_threshold: 0.05,
        shade_survival_years: 4,
        shedding_mean_threshold: 0.0, // proxy Malus domestica pilot, estimated
        // A shrub keeps its low branches (estimated).
        clear_bole_fraction: 0.05,
        clear_bole_max_m: 0.5,
        clear_bole_limb_ratio: 0.5, // proxy Malus domestica pilot, estimated
        // A stem lives 60-90 y [atlas_lifespan] [fls_lifespan] [fr_wiki_cultivar_life]:
        // dieback from ~40 y (estimated).
        retrenchment_onset_years: 40.0,
        retrenchment_rate: 0.10, // proxy Malus domestica pilot, estimated
        retrenchment_ramp_years: 30.0,
        retrenchment_reach: 0.6, // proxy Malus domestica pilot, estimated
        epicormic_rate: 0.08,
        // Height ceiling of a stem, calibrated on 4-8 m [atlas_height] / 5-6 m
        // [de_wiki_height] (tall tree forms of 10-15 m are exceptions).
        hydraulic_path_max_m: 8.0,
        hydraulic_exponent: 1.0,
        hydraulic_foliage_exponent: 1.2, // proxy Malus domestica pilot, estimated
    ),
    leaf: (
        // Rounded leaf 6-12 cm, doubly serrate, hairy [atlas_leaf].
        length_cm: 9.0,
        width_cm: 8.0,
        lobes: 0, // proxy Malus domestica pilot, estimated
        serration: 0.8,
        deciduous: true, // proxy Malus domestica pilot, estimated
        marcescence: 0.0, // proxy Malus domestica pilot, estimated
        marcescence_max_age_years: 1.0, // proxy Malus domestica pilot, estimated
        leaves_per_shoot: 8.0, // proxy Malus domestica pilot, estimated
        cluster_size_leaves: 3.0, // proxy Malus domestica pilot, estimated
        foliage_density: 4.0, // proxy Malus domestica pilot, estimated
        tip_bunching: 0.3, // proxy Malus domestica pilot, estimated
        petiole_ratio: 0.15,
        leaf_droop: 0.4, // proxy Malus domestica pilot, estimated
        // No spur shoots (estimated).
        spur_foliage: 0.0,
        spur_max_radius_mm: 40.0, // proxy Malus domestica pilot, estimated
        spur_min_light: 0.1, // proxy Malus domestica pilot, estimated
        colour_spread: 0.5, // proxy Malus domestica pilot, estimated
    ),
    pigments: (
        chlorophyll: 1.0, // proxy Malus domestica pilot, estimated
        // Yellow autumn colour (calibrated by eye).
        carotenoids: 0.9,
        anthocyanins: 0.1,
        tannins: 0.5, // proxy Malus domestica pilot, estimated
        anthocyanin_persistence: 0.0, // proxy Malus domestica pilot, estimated
    ),
    phenology: (
        // Chilling requirement not found [absence_corylus_0_chilling]: estimated.
        chilling_requirement_days: 45.0,
        chill_temp_min_c: -100.0, // proxy Malus domestica pilot, estimated
        chill_temp_max_c: 5.0, // proxy Malus domestica pilot, estimated
        gdd_base_c: 5.0, // proxy Malus domestica pilot, estimated
        // Estimated: no Breton or British date found [absence_corylus_1_flowering].
        // Leafing is in April; flowering well before the leaves.
        gdd_budburst: 190.0,
        chill_forcing_gdd: 250.0, // proxy Malus domestica pilot, estimated
        forcing_start_doy: 31, // proxy Malus domestica pilot, estimated
        chill_start_doy: 304, // proxy Malus domestica pilot, estimated
        leaf_expansion_gdd: 180.0,
        senescence_photoperiod_h: 12.0, // proxy Malus domestica pilot, estimated
        senescence_temp_base_c: 17.0, // proxy Malus domestica pilot, estimated
        senescence_cdd: 170.0, // proxy Malus domestica pilot, estimated
        leaf_fall_days: 20.0, // proxy Malus domestica pilot, estimated
    ),
    wood: (
        // Density 570-630 kg/m3 at 15 % moisture (r15) [de_wiki_density]: mid value kept
        // as published (the basic density is lower, not given; convention differs).
        density_kg_m3: 590.0,
        // No MOR/MOE found: estimated (proxy Prunus/Rosaceae diffuse-porous woods).
        elasticity_gpa: 9.0,
        // Diffuse-porous (estimated).
        ring_porous: false,
        earlywood_share: 0.4, // proxy Malus domestica pilot, estimated
        ring_contrast: 0.25, // proxy Malus domestica pilot, estimated
        // Calibrated by shape: no DBH-age table [absence_corylus_2_dbh]; a stem of the
        // stool is 5-15 cm in diameter (estimated).
        growth_coefficient: 0.00012,
        twig_radius_mm: 2.5,
        max_ring_width_mm: 8.0,
        pipe_exponent: 2.2, // proxy Malus domestica pilot, estimated
        limb_draw_boost: 1.3, // proxy Malus domestica pilot, estimated
        bark_irregularity: 0.06, // proxy Malus domestica pilot, estimated
        adaptive_stress_mpa: 11.1, // proxy Malus domestica pilot, estimated
        adaptive_min_diameter_cm: 5.0, // proxy Malus domestica pilot, estimated
        adaptive_max_budget_share: 0.3, // proxy Malus domestica pilot, estimated
        collar_flare: 0.25, // proxy Malus domestica pilot, estimated
        root_flare: 0.3, // proxy Malus domestica pilot, estimated
        root_flare_height_radii: 1.5, // proxy Malus domestica pilot, estimated
        buttress_lobes: 0, // proxy Malus domestica pilot, estimated
        snag_years_per_m: 120.0, // proxy Malus domestica pilot, estimated
    ),
    bark: (
        // Smooth, copper-brown bark with white horizontal lenticels, no rhytidome
        // [de_wiki] [fr_wiki] (qualitative); longitudinal fissures with age.
        color: (0.45, 0.33, 0.25),
        young_color: (0.50, 0.36, 0.26),
        old_darkening: (0.12, 0.10, 0.08), // proxy Malus domestica pilot, estimated
        lenticels: 0.7,
        fissures: 0.3,
        gloss: 0.15, // proxy Malus domestica pilot, estimated
    ),
    roots: (
        // Weak taproot (estimated); roots 3-4 m long in hedges [de_wiki_root_length];
        // no depth found [absence_corylus_3_root].
        taproot_dominance: 0.15,
        taproot_decline_years: 8.0, // proxy Malus domestica pilot, estimated
        max_depth_m: 1.4,
        lateral_spread: 2.5,
        lateral_count: 9, // proxy Malus domestica pilot, estimated
        lateral_depth_m: 0.4, // proxy Malus domestica pilot, estimated
        sinker_tendency: 0.15, // proxy Malus domestica pilot, estimated
        branching_probability: 0.35, // proxy Malus domestica pilot, estimated
        max_order: 3, // proxy Malus domestica pilot, estimated
        annual_extension_m: 0.8, // proxy Malus domestica pilot, estimated
        max_penetration_mpa: 2.5, // proxy Malus domestica pilot, estimated
        waterlogging_tolerance: 0.2, // proxy Malus domestica pilot, estimated
        hypoxia_sensitivity: 0.5, // proxy Malus domestica pilot, estimated
        hypoxia_air_porosity: 0.12, // proxy Malus domestica pilot, estimated
        drought_deepening: 0.3, // proxy Malus domestica pilot, estimated
        hydrotropism: 0.4, // proxy Malus domestica pilot, estimated
        root_shoot_ratio: 0.25, // proxy Malus domestica pilot, estimated
        root_shoot_stress_gain: 0.5, // proxy Malus domestica pilot, estimated
        fine_root_per_m: 1000.0, // proxy Malus domestica pilot, estimated
        rapid_taper: 1.0, // proxy Malus domestica pilot, estimated
    ),
    tolerances: (
        // Hardy shrub (qualitative, trait sheet); young leaves, estimated
        // [absence_corylus_5_frost].
        frost_c: -3.0,
        drought: 0.45,
        // Grows in full light as in shade [atlas_leaf]: 0.5-0.6 (trait sheet, estimated).
        shade: 0.55,
    ),
    reproduction: (
        // Nut mass not found [absence_corylus_4_nut]: estimated (informative).
        fruit_mass_g: 2.0,
        // Franc: not found; full production at 8-12 y in culture
        // [fr_wiki_full_production]: first flowering ~6 y (estimated).
        first_flowering_age_years: 6.0,
        // Male catkins up to 10 cm, bare in winter [atlas_catkin]; female flowers
        // minuscule. One flower type is drawn (engine gap).
        flower_display: 1.0,
        fruit_display: 1.0, // proxy Malus domestica pilot, estimated
        // Flowering February-March [de_wiki_flowering] (doy 32-90), doy 73-78 in Slovakia
        // [sk_flowering_1964] [sk_flowering_1994], 19 January on the Italian coast
        // [sk_italy_onset]. The engine starts counting on 1 February (limit); calibrated.
        bloom_gdd: 12.0,
        // Flowering lasts 7-9 days [sk_flowering_duration].
        bloom_duration_gdd: 18.0,
        min_wood_age_years: 1,
        min_light: 0.1,
        max_wood_radius_mm: 30.0, // proxy Malus domestica pilot, estimated
        flower_density: 3.0,
        flower_cluster_cm: 8.0,
        // Nut <= 2 cm [atlas_nut] in its husk.
        fruit_cluster_cm: 2.5,
        // Yellow catkins (qualitative).
        flower_color: (0.80, 0.74, 0.35),
        fruit_set: 0.3,
        // Catkin / flower frost threshold not found [absence_corylus_5_frost]: flowers in
        // winter and withstands frost; -8 degC estimated, deliberately cold-tolerant.
        flower_frost_c: -8.0,
        // Nuts ripe on 30 August (doy 242) in Slovakia [sk_nut_ripeness] after a
        // flowering on doy 73-78 [sk_flowering_1964]: ~165 d (derived).
        fruit_ripening_days: 165.0,
        fruit_persistence_days: 30.0,
        fruit_color_unripe: (0.45, 0.60, 0.22),
        fruit_color_ripe: (0.55, 0.38, 0.18),
        fruit_kind: Nut,
        // Annual bearing assumed (no alternation source, estimated).
        crop_interval_years: 1.0,
        off_year_crop: 0.15,
    ),
    longevity: (
        // Stem life 60-90 y [atlas_lifespan] [fls_lifespan].
        decline_onset_years: 45.0,
        decline_years: 30.0,
        decline_min_vigour: 0.3, // proxy Malus domestica pilot, estimated
        // Carbon balance of ageing (crates/dendro-core/src/vitality.rs):
        // maintenance of the living wood per metre of collar-to-leaf
        // distance, relative to the production of the same foliage.
        // Calibrated: no measured value exists; tuned (seeds 1-5) so that
        // the trunk dies, emergently, within the published longevity,
        // 80-90 y (Atlas) (data/validation/corylus_avellana.ron).
        // While > 0 the age-scheduled decline_* values above are ignored.
        // Recalibrated 0.0145 -> 0.0147 (2026-11-20, approved by the user):
        // the wind acclimation of the stem (wind.rs) perturbed the
        // trajectories and seed 4 lived 99 y instead of 90, moving the median
        // of seeds 1-5 to 97 y; with 0.0147 the seeds die at 80, 97, 85, 99,
        // 71 y (median 85).
        maintenance_per_m: 0.0147,
    ),
    symbiosis: (
        // ECTOMYCORRHIZAL (Tuber, Amanita rubescens, Boletus edulis, Cenococcum, Laccaria,
        // Paxillus) [de_wiki_mycorrhiza] [en_wiki_mycorrhiza], like the oak; shares and
        // reach are the oak pilot's calibrations (flux view only).
        mycorrhiza: Ecto,
        carbon_cost: 0.15,
        phosphorus_share: 0.6,
        nitrogen_share: 0.4,
        water_share: 0.05,
        hyphal_reach_m: 0.35,
    ),
    pruning: (
        // Vigorous sprouting after cutting (trait sheet, qualitative); values estimated.
        epicormic_potential: 0.8,
        sprout_vigour: 2.0,
        // Sprouts vigorously from the stump; regular coppicing [atlas_sprout]
        // [rhs_coppice_rotation] (5-7 y rotation).
        stump_sprouting: 1.0,
        root_suckering: 0.3,
        compensatory_growth: 0.6,
        woundwood_ratio: 1.6, // proxy Malus domestica pilot, estimated
        compartmentalization: 0.5, // proxy Malus domestica pilot, estimated
        decay_infection_rate: 0.08, // proxy Malus domestica pilot, estimated
        decay_axial_m_per_year: 0.1, // proxy Malus domestica pilot, estimated
        decay_radial_mm_per_year: 6.0, // proxy Malus domestica pilot, estimated
        pathogen_dormant_risk: 0.25, // proxy Malus domestica pilot, estimated
        pathogen_summer_risk: 0.08, // proxy Malus domestica pilot, estimated
        pathogen_dieback_years: 3.0, // proxy Malus domestica pilot, estimated
        reserve_in_branches: 0.35, // proxy Malus domestica pilot, estimated
        root_balance_rate: 0.4, // proxy Malus domestica pilot, estimated
        sap_bleeding: 0.1, // proxy Malus domestica pilot, estimated
        // Life of ONE STEM: 80-90 y [atlas_lifespan] (lower end chosen), 70 y [fls_lifespan], 60 y for the
        // cultivar [fr_wiki_cultivar_life]. The stool lasts longer (not representable).
        typical_lifespan_years: 80.0,
    ),
    mechanics: (
        // Not found: estimated from the density at 15 % with ~60 % moisture.
        green_density_kg_m3: 950.0,
        // No MOR/MOE found: estimated by proxy (Rosaceae woods).
        green_mor_mpa: 50.0,
        green_moe_gpa: 7.5,
        crown_drag_coefficient: 0.2, // proxy Malus domestica pilot, estimated
        vogel_exponent: -1.0, // proxy Malus domestica pilot, estimated
        anchorage_nm_per_kg: 178.1, // proxy Malus domestica pilot, estimated
    ),
)

