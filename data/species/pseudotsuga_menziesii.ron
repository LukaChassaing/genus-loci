// Douglas fir, Pseudotsuga menziesii (Mirb.) Franco. Started from the
// Norway spruce pilot (picea_abies.ron). Reference values:
// data/validation/pseudotsuga_menziesii.ron (ids in brackets) and the trait
// sheet docs/species/pseudotsuga_menziesii.md. Status of each value:
// "measured" (a published value read by the research agent), "proxy"
// (another species), "estimated" (general knowledge, no source read),
// "calibrated" (tuned so the emergent tree matches the references).
// Introduced in Europe in 1827; the engine grows it in the Rennes climate.
// No open-grown tree and no Breton height-age table were found (trait
// sheet). Size targets: European heights over 60 m [wde_height_europe] and
// a ~2 m trunk [wfr_dbh] [atlas_dbh_native] read by the bench at its
// "adult" age (0.6 x typical_lifespan_years = 300 y); very fast youth.
// Stand values are only sanity checks, not targets: ONF fertility classes
// 26-40 m at 50 y [cnpf_h50], harvest at 30-35 m at 45 y [cnpf_harvest],
// British plantation mean DBH 35-53 cm at 40-50 y [fc34_df_yc20_dbh_40]
// etc. (an open-grown tree is expected thicker and a little lower).
(
    species: "Pseudotsuga menziesii",
    common_name: "Douglas fir",
    common_name_fr: "Douglas",
    category: Conifer,
    architecture: (
        // Cylindrical stem, conical crown when young, flatter irregular
        // dome when old (trait sheet): strong but declining apical control
        // (calibrated by eye).
        apical_dominance_young: 0.80,
        apical_dominance_mature: 0.66,
        maturity_age_years: 200.0,
        juvenile_phase_years: 60.0,
        apical_dominance_branches: 0.6,
        lateral_competition: 1.5,
        // Calibrated: very fast juvenile growth (trait sheet; no leader
        // growth value found).
        vigour_per_light: 6.2,
        bud_break_threshold: 1.0,
        internode_length_m: 0.05,
        max_shoot_length_m: 0.90,
        // Spaced whorls with interwhorl branchlets (trait sheet: branches
        // in spaced whorls); count estimated.
        lateral_buds_per_shoot: 5,
        lateral_buds_per_metamer: 0.4,
        bud_lifetime_years: 2,
        whorled: true,
        lateral_planarity: 0.45,
        branching_angle_deg: 70.0,
        phyllotaxis_deg: 137.5,
        max_order: 8,
        // Branches with drooping twigs (trait sheet; set-points by eye).
        gravitropism: 1.0,
        lateral_gravitropism: 0.35,
        limb_setpoint_low_deg: 95.0,
        limb_setpoint_high_deg: 60.0,
        twig_setpoint_deg: 105.0,
        // Conical crown (calibrated by eye).
        crown_spread_ratio: 0.40,
        phototropism: 0.08,
        sinuosity_deg: 3.0,
        leader_loss_probability: 0.02,
        leader_loss_angle_deg: 15.0,
        sag_coefficient: 4.0,
        sag_min_radius_mm: 20.0,
        sag_max_deg_per_year: 0.6,
        sag_max_total_deg: 15.0,
        sag_max_droop_deg: 25.0,
        sag_min_inclination_deg: 50.0,
        straightening_deg_per_year: 2.0,
        straightening_keep_deg: 5.0,
        straightening_min_radius_mm: 25.0,
        // Intermediate shade tolerance [atlas_shade]; dead branches persist
        // (trait sheet, estimated strengths).
        shedding_threshold: 0.06,
        shade_survival_years: 4,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.05,
        clear_bole_max_m: 1.5,
        clear_bole_limb_ratio: 0.3,
        retrenchment_onset_years: 0.0,
        retrenchment_rate: 0.0,
        retrenchment_ramp_years: 100.0,
        retrenchment_reach: 1.0,
        epicormic_rate: 0.0,
        // Calibrated: ~34 m at 50 y (ONF classes 26-40 m [cnpf_h50]),
        // ~49 m at 100 y, ~60 m at 300 y (> 60 m in Europe
        // [wde_height_europe]; French record 68.9 m [wfr_height_france]).
        hydraulic_path_max_m: 58.0,
        hydraulic_exponent: 1.3,
        hydraulic_foliage_exponent: 1.0,
    ),
    leaf: (
        // Needles 2-3.5 cm [atlas_needle_length], 1.5-3 [wfr_needle_length].
        length_cm: 2.6,
        width_cm: 0.15,
        lobes: 0,
        serration: 0.0,
        deciduous: false,
        marcescence: 0.0,
        marcescence_max_age_years: 1.0,
        leaf_type: Needle,
        // 5-6 years [wfr_needle_longevity].
        leaf_longevity_years: 5.5,
        // Not found (trait sheet): the spruce's values (proxy).
        lma_g_m2: 200.0,
        crown_lai: 4.0,
        leaves_per_shoot: 60.0,
        cluster_size_leaves: 7.0,
        foliage_density: 2.8,
        tip_bunching: 0.0,
        petiole_ratio: 0.0,
        leaf_droop: 0.6,
        spur_foliage: 0.0,
        spur_max_radius_mm: 15.0,
        spur_min_light: 0.1,
        colour_spread: 0.3,
    ),
    // Calibration by eye: mid-green needles.
    pigments: (
        chlorophyll: 1.2,
        carotenoids: 0.55,
        anthocyanins: 0.0,
        tannins: 0.5,
        anthocyanin_persistence: 0.0,
    ),
    phenology: (
        // No budburst date found (trait sheet): estimated between the fir
        // and the spruce genomes of this registry.
        chilling_requirement_days: 50.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 380.0,
        chill_forcing_gdd: 300.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 350.0,
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 16.0,
        senescence_cdd: 150.0,
        leaf_fall_days: 40.0,
    ),
    wood: (
        // Basic specific gravity 0.45 (Wood Database, coast Douglas fir
        // [wdb_density] site field): 450 kg/m3.
        density_kg_m3: 450.0,
        // Green MOE: as the spruce genome (proxy); no green value found.
        elasticity_gpa: 9.2,
        ring_porous: false,
        earlywood_share: 0.6,
        ring_contrast: 0.8,
        // Calibrated: ~2.0 m at 300 y against ~2 m [wfr_dbh] (2.45 m at
        // 400 y: the engine never kills the tree); ~49 cm at 50 y, within
        // the plantation means (45-53 cm,
        // [fc34_df_yc20_dbh_50] [fc34_df_yc24_dbh_50]).
        growth_coefficient: 0.000420,
        twig_radius_mm: 2.2,
        max_ring_width_mm: 12.0,
        pipe_exponent: 2.0,
        limb_draw_boost: 1.1,
        bark_irregularity: 0.03,
        adaptive_stress_mpa: 11.1,
        adaptive_min_diameter_cm: 5.0,
        adaptive_max_budget_share: 0.3,
        collar_flare: 0.15,
        root_flare: 0.4,
        root_flare_height_radii: 1.4,
        buttress_lobes: 5,
        snag_years_per_m: 300.0,
    ),
    // Thick corky bark, deeply furrowed when old [wen_bark] (colours
    // estimated).
    bark: (
        color: (0.38, 0.27, 0.22),
        young_color: (0.45, 0.42, 0.38),
        old_darkening: (0.10, 0.08, 0.07),
        lenticels: 0.1,
        fissures: 0.85,
        gloss: 0.03,
    ),
    roots: (
        // Well-developed spreading system [wfr_root], heart-shaped (trait
        // sheet); deeper taproot on dry sites. No depth found: estimated.
        taproot_dominance: 0.5,
        taproot_decline_years: 15.0,
        max_depth_m: 2.0,
        lateral_spread: 1.6,
        lateral_count: 12,
        lateral_depth_m: 0.3,
        sinker_tendency: 0.25,
        branching_probability: 0.35,
        max_order: 3,
        annual_extension_m: 0.8,
        max_penetration_mpa: 2.8,
        // Not stated in the references (estimated, as the spruce).
        waterlogging_tolerance: 0.3,
        hypoxia_sensitivity: 0.3,
        hypoxia_air_porosity: 0.12,
        drought_deepening: 0.2,
        hydrotropism: 0.3,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.4,
        fine_root_per_m: 1200.0,
        rapid_taper: 1.5,
    ),
    tolerances: (
        // Sensitive to early (autumn) frosts (trait sheet; not modelled);
        // new shoots: estimated.
        frost_c: -3.0,
        // Less vulnerable to drought than the spruce [atlas_drought] but
        // hit by exceptional droughts [wfr_drought] (estimated).
        drought: 0.35,
        // Intermediate: tolerant in mid and late succession [atlas_shade].
        shade: 0.5,
    ),
    reproduction: (
        // 12-15 y [atlas_first_cones]; 15-40 [wde_first_flowering];
        // ~40 y in Britain [fruk_coning]: the open-grown (earliest) end,
        // 14 so that the +-1 y spread stays within 12-15.
        first_flowering_age_years: 14.0,
        // Flowering April-May [wde_flowering]; pendent cones 4-10 cm
        // [atlas_cone_length] [wfr_cone_length], ripe the first autumn
        // (trait sheet, estimated).
        flower_display: 0.35,
        fruit_display: 1.0,
        bloom_gdd: 400.0,
        bloom_duration_gdd: 90.0,
        min_wood_age_years: 1,
        min_light: 0.4,
        max_wood_radius_mm: 15.0,
        flower_density: 0.8,
        flower_cluster_cm: 3.0,
        fruit_cluster_cm: 7.0,
        flower_color: (0.65, 0.35, 0.40),
        fruit_set: 0.6,
        flower_frost_c: -3.0,
        fruit_ripening_days: 120.0,
        fruit_persistence_days: 60.0,
        fruit_color_unripe: (0.38, 0.45, 0.25),
        fruit_color_ripe: (0.52, 0.38, 0.24),
        fruit_kind: ConePendent,
        // No interval found: masting estimated as the spruce.
        crop_interval_years: 3.0,
        off_year_crop: 0.15,
    ),
    // 400-500 y in the native range [wfr_longevity]; decline estimated.
    longevity: (
        decline_onset_years: 350.0,
        decline_years: 150.0,
        decline_min_vigour: 0.4,
        // Carbon balance of ageing (crates/dendro-core/src/vitality.rs):
        // maintenance of the living wood per metre of collar-to-leaf
        // distance, relative to the production of the same foliage.
        // Calibrated: no measured value exists; tuned (seeds 1-5) so that
        // the trunk dies, emergently, within the published longevity,
        // 400-500 y in France, 500-1300 native: beyond the 400-year bench run (data/validation/pseudotsuga_menziesii.ron).
        // Set low enough that the cost stays below ~75 % of production
        // within 400 years (only censored runs can be checked).
        // While > 0 the age-scheduled decline_* values above are ignored.
        maintenance_per_m: 0.001,
    ),
    // Pinaceae: ectomycorrhizal (guide; trait sheet "estimé").
    symbiosis: (
        mycorrhiza: Ecto,
        carbon_cost: 0.15,
        phosphorus_share: 0.6,
        nitrogen_share: 0.4,
        water_share: 0.05,
        hyphal_reach_m: 0.35,
    ),
    // No stump sprouts (trait sheet, estimated).
    pruning: (
        epicormic_potential: 0.02,
        sprout_vigour: 0.5,
        stump_sprouting: 0.0,
        root_suckering: 0.0,
        compensatory_growth: 0.1,
        woundwood_ratio: 1.2,
        compartmentalization: 0.4,
        decay_infection_rate: 0.10,
        decay_axial_m_per_year: 0.12,
        decay_radial_mm_per_year: 5.0,
        pathogen_dormant_risk: 0.1,
        pathogen_summer_risk: 0.15,
        pathogen_dieback_years: 3.0,
        reserve_in_branches: 0.3,
        root_balance_rate: 0.3,
        sap_bleeding: 0.1,
        // 400-500 y [wfr_longevity] (native range).
        typical_lifespan_years: 500.0,
    ),
    mechanics: (
        // No green values found (trait sheet): the spruce genome's (proxy).
        green_density_kg_m3: 800.0,
        green_mor_mpa: 41.0,
        green_moe_gpa: 9.2,
        crown_drag_coefficient: 0.2,
        vogel_exponent: -1.0,
        // ForestGALES parameterises Douglas fir but no coefficient was
        // extracted (trait sheet): the spruce genome's Sitka value (proxy).
        anchorage_nm_per_kg: 178.1,
    ),
)
