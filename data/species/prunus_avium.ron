// Wild cherry, Prunus avium (L.) L.
// Same trait set as the oak (data/species/quercus_robur.ron); the cherry
// differs only by these numbers. Values are literature-plausible orders of
// magnitude; those marked "calibrated" were tuned so the emergent tree
// matches open-grown wild cherry (fast youth, ~20-25 m, short life).
// Main sources: Savill 2013 "The Silviculture of Trees used in British
// Forestry"; Russell 2003 (EUFORGEN Technical Guidelines, Prunus avium);
// Welk et al. 2016 (European Atlas of Forest Tree Species).
// Full references in docs/sources.md. Note: those general sources describe
// the species qualitatively; most numeric values below are calibrations.
(
    species: "Prunus avium",
    common_name: "Wild cherry",
    common_name_fr: "Merisier",
    architecture: (
        // Apical control of the stem (calibrated): strong in the conical
        // sapling (single leader, regular tiers), then easing from ~18 y so
        // that the scaffold limbs get enough vigour to build a broad ovoid
        // crown. It stays just above 0.5, so the straight stem remains
        // readable high into the crown and never dissolves into co-dominant
        // limbs as in the oak (0.42). With lambda ~0.6-0.7 kept for life the
        // stem took most of the vigour and the limbs stayed short whips
        // (a 21 m spire with W/H ~0.35 at 40 y).
        apical_dominance_young: 0.70,
        apical_dominance_mature: 0.51,
        maturity_age_years: 45.0,
        juvenile_phase_years: 18.0,
        apical_dominance_branches: 0.52,
        // Moderate competition between sibling branches: in each tier a few
        // well-lit scaffold limbs take the lead (fewer than the oak's) and
        // ramify, instead of many similar starved branches.
        lateral_competition: 2.0,
        // Metamers per unit light (calibrated): vigorous pioneer.
        vigour_per_light: 7.5,
        bud_break_threshold: 1.0,
        // Long shoots: internodes 3-6 cm, leaders 0.8-1.2 m/yr in youth
        // (cherry is one of the fastest-growing European broadleaves).
        internode_length_m: 0.05,
        max_shoot_length_m: 0.72,
        // Buds crowded at the end of the annual shoot: branches in
        // pseudo-whorls (tiers), the textbook cherry habit (Savill 2013).
        lateral_buds_per_shoot: 5,
        lateral_buds_per_metamer: 0.35,
        bud_lifetime_years: 3,
        // Narrow, ascending insertion angle.
        branching_angle_deg: 42.0,
        // Prunus: 2/5 phyllotaxis.
        phyllotaxis_deg: 144.0,
        max_order: 120,
        // Strongly orthotropic leader; ascending limbs (calibrated by eye):
        // lower tiers at ~55 deg from vertical, upper ones ~25 deg.
        gravitropism: 0.6,
        lateral_gravitropism: 0.35,
        limb_setpoint_low_deg: 55.0,
        limb_setpoint_high_deg: 25.0,
        twig_setpoint_deg: 55.0,
        // Open-grown cherry crowns are conical, then ovoid (width ~0.45-0.6 x
        // height at 40 y), rounded-ovoid when old (~0.7; the oak's exceed 1).
        // Calibrated; with the steep limb set-points above the tips turn up
        // before the limbs reach this spread.
        crown_spread_ratio: 1.0,
        phototropism: 0.10,
        // Straight stem and limbs: little random deviation, rare loss of
        // the terminal bud (no oak "elbows").
        sinuosity_deg: 4.0,
        leader_loss_probability: 0.04,
        leader_loss_angle_deg: 15.0,
        // Light limbs: little sag (same stylised model as the oak).
        sag_coefficient: 2.5,
        sag_min_radius_mm: 40.0,
        sag_max_deg_per_year: 0.4,
        sag_max_total_deg: 6.0,
        sag_max_droop_deg: 5.0,
        sag_min_inclination_deg: 50.0,
        straightening_deg_per_year: 1.5,
        straightening_keep_deg: 6.0,
        // Calibration: 15 -> 25 mm with the thicker juvenile wood of the
        // wood budget (see the oak genome).
        straightening_min_radius_mm: 25.0,
        // Strongly light-demanding (shade-intolerant pioneer): shaded
        // branches die within a couple of years, so the lower crown is
        // shed quickly and a natural clear bole forms (calibrated).
        shedding_threshold: 0.10,
        shade_survival_years: 2,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.2,
        clear_bole_max_m: 4.5,
        clear_bole_limb_ratio: 0.5,
        // Short-lived tree (individual trees 100-150 y according to the Future
        // Trees Trust wild cherry monograph; Russell 2003): crown dieback from ~80 y (heart rot, bacterial
        // canker and silver leaf disease attack old cherries; few live
        // beyond ~100-150 y, Russell 2003). Fast ramp, little reiteration.
        retrenchment_onset_years: 80.0,
        retrenchment_rate: 0.12,
        retrenchment_ramp_years: 30.0,
        retrenchment_reach: 0.6,
        epicormic_rate: 0.01,
        // Collar-to-bud distance where extension stops (calibrated on a
        // 20-28 m plateau). Low exponent: height growth slows steadily from
        // youth (17-19 m at 40 y, 20-22 m at 60 y) instead of racing to the
        // plateau as a spire.
        hydraulic_path_max_m: 25.0,
        hydraulic_exponent: 1.3,
        // Pioneer: foliage stays efficient until the tree nears its size
        // limit (calibrated), then declines steeply.
        hydraulic_foliage_exponent: 1.5,
    ),
    leaf: (
        // Obovate-oblong, acuminate leaves 6-15 cm x 3-7 cm, unlobed,
        // coarsely and doubly serrate, petiole with red glands.
        length_cm: 10.0,
        width_cm: 5.0,
        lobes: 0,
        serration: 0.8,
        deciduous: true,
        // No marcescence.
        marcescence: 0.0,
        marcescence_max_age_years: 1.0,
        leaves_per_shoot: 8.0,
        // Rendering: lighter, less dense crown than the oak's.
        cluster_size_leaves: 3.0,
        foliage_density: 4.0,
        // Leaves spaced along the shoot on long (2-5 cm) petioles, the
        // blades hanging.
        tip_bunching: 0.1,
        petiole_ratio: 0.3,
        leaf_droop: 0.7,
        // Leaf rosettes on spurs (short shoots) along 2+ year wood fill the
        // crown between the long shoots; a light-demanding pioneer, so they
        // die out in shade.
        spur_foliage: 5.0,
        spur_max_radius_mm: 50.0,
        spur_min_light: 0.08,
        colour_spread: 0.5,
    ),
    pigments: (
        chlorophyll: 1.0,
        // Calibration: pigment weights are tuned by eye for the renderer.
        // Brilliant orange-red autumn colour: strong anthocyanin synthesis
        // over carotenoid yellow, little brown; the red persists until the
        // leaves fall.
        carotenoids: 0.5,
        anthocyanins: 1.6,
        tannins: 0.2,
        anthocyanin_persistence: 0.9,
        // Scarlet rather than the brick-red default.
        anthocyanin_color: (0.78, 0.14, 0.06),
    ),
    phenology: (
        // Same chilling-forcing model as the oak (Cannell & Smith 1983;
        // Murray, Cannell & Smith 1989 fitted it to P. avium too, but their
        // coefficients could not be read here). Chilling requirement: sweet
        // cherry cultivars need 176-788 h below 7 degC (397-1001 Utah chill
        // units), most of them ~400-800 h (Alburquerque et al. 2008, Environ
        // Exp Bot 64:162-170, doi:10.1016/j.envexpbot.2008.01.003, Table 3,
        // Murcia; no figure was found for wild, forest P. avium). The former
        // "~1000 chill hours" matched only the latest cultivar in chill
        // units. Here the requirement is mostly met after ~30 days with a
        // mean <= 5 degC (a typical Rennes winter), i.e. like the oak's.
        // Calibration: a, b and the requirement are tuned so that leaf-out
        // falls in early-mid April, about a week before the oak, together
        // with the bloom.
        chilling_requirement_days: 45.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 185.0,
        chill_forcing_gdd: 250.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 170.0,
        // Senescence structure after Delpierre et al. 2009 (fitted for beech
        // and oak, not cherry: values here are calibrated).
        // Early senescence: colouring from mid-September, leaves gone by
        // late October (a month before the oak).
        senescence_photoperiod_h: 12.4,
        senescence_temp_base_c: 18.0,
        senescence_cdd: 115.0,
        leaf_fall_days: 12.0,
    ),
    wood: (
        // Basic density ~0.5-0.6 g/cm3; green MOE ~7-9 GPa.
        density_kg_m3: 560.0,
        elasticity_gpa: 8.0,
        // Diffuse- to semi-ring-porous: earlywood vessels only slightly
        // larger than latewood ones, so the ring contrast is weak.
        ring_porous: false,
        earlywood_share: 0.4,
        ring_contrast: 0.3,
        // Wood volume per unit of light-weighted foliage and year (see the
        // oak genome). Calibration: free-growth cherry, Pryor 1988 (FC
        // Bulletin 75, Table 7: 14 cm @15, 30 @40, 44 @60, 50 @70) to 60 cm
        // in 50-60 y on favourable sites (Evans 1984, cited by the Future
        // Trees Trust). Model: 14 @15, 37-39 @40, 52-54 @60, 76-78 @100.
        // Juvenile rings ~5.5-6.5 mm (up to ~1 cm on vigorous young trees).
        // Was 3.3e-5 (8 cm @15, 26 @40, 40 @60).
        growth_coefficient: 0.000620,
        twig_radius_mm: 2.5,
        max_ring_width_mm: 12.0,
        // Mesh: slender limbs, round stem, a modest root collar flare.
        // Within Eloy's 2011 range (1.8-2.3, see the oak file); calibration:
        // near da Vinci's 2 for the slender, excurrent cherry (it was 2.3).
        pipe_exponent: 2.1,
        limb_draw_boost: 1.3,
        bark_irregularity: 0.02,
        collar_flare: 0.2,
        root_flare: 0.35,
        root_flare_height_radii: 1.5,
        buttress_lobes: 0,
        // Non-durable wood: dead cherry limbs rot and fall within a few
        // years to a couple of decades.
        snag_years_per_m: 150.0,
    ),
    // Bark (renderer): smooth, glossy, red-brown to purplish-brown periderm
    // with conspicuous horizontal bands of lenticels, peeling in horizontal
    // strips; old trunks become darker and fissured only near the base.
    bark: (
        color: (0.42, 0.21, 0.18),
        young_color: (0.45, 0.30, 0.22),
        old_darkening: (0.14, 0.06, 0.05),
        lenticels: 0.9,
        fissures: 0.15,
        gloss: 0.6,
    ),
    roots: (
        // Superficial, wide-spreading "tracing" root system: a short-lived
        // taproot, strong horizontal laterals in the top ~30 cm that root
        // suckers arise from, few sinkers (Kutschera & Lichtenegger 2002;
        // Savill 2013).
        taproot_dominance: 0.35,
        taproot_decline_years: 5.0,
        max_depth_m: 1.8,
        lateral_spread: 2.6,
        lateral_count: 10,
        lateral_depth_m: 0.3,
        sinker_tendency: 0.12,
        branching_probability: 0.35,
        max_order: 3,
        annual_extension_m: 1.1,
        max_penetration_mpa: 2.6,
        // Very intolerant of waterlogging and heavy, poorly drained clays
        // (root asphyxia, Phytophthora): roots do not enter saturated soil.
        waterlogging_tolerance: 0.05,
        // ... and its roots suffer from poor aeration of heavy, wet clays
        // even short of saturation (root asphyxia; Prunus rootstocks are
        // among the most flooding-sensitive fruit trees, Schaffer et al.
        // 1992). Stylised strength (calibrated).
        hypoxia_sensitivity: 1.0,
        // Mazzard F12/1 (a P. avium rootstock clone) lost 51.5 % of its shoot
        // growth and 69 % of its maximum photosynthesis in soil at 9 %
        // against 21 % air-filled porosity, where tolerant Prunus rootstocks
        // did not (Morales-Olmedo et al. 2021, Plant Soil 469:457-473,
        // doi:10.1007/s11104-021-05184-5; rootstocks, not wild seedlings).
        // Calibration: hypoxia counted from 15 % air-filled porosity
        // (generic 10 %).
        hypoxia_air_porosity: 0.15,
        drought_deepening: 0.3,
        hydrotropism: 0.4,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.6,
        fine_root_per_m: 1000.0,
        rapid_taper: 1.0,
    ),
    tolerances: (
        // Young leaves are about as frost-sensitive as the oak's.
        frost_c: -2.0,
        // Fairly drought tolerant on deep, well-drained soils.
        drought: 0.45,
        // Shade tolerant when young, becoming strongly light-demanding with
        // age (Future Trees Trust wild cherry monograph, citing Joyce et al.
        // 1998 and Savill; "light demanding" for the adult tree in Russell
        // 2003 and Welk et al. 2016). Calibration: the juvenile value 0.55
        // (oak 0.3) and the 8 -> 20 year transition are ours; no source
        // gives the age.
        shade: 0.25,
        shade_juvenile: Some(0.55),
        shade_juvenile_years: 8.0,
        shade_mature_years: 20.0,
    ),
    reproduction: (
        // Seedlings flower from ~4-7 years when open-grown (EUFORGEN: from
        // about 4 y under optimal conditions; Pryor 1988, Forestry Commission
        // Bulletin 75: often under 10 y).
        first_flowering_age_years: 5.5,
        // Showy white flowers, red-black cherries.
        flower_display: 1.0,
        fruit_display: 1.0,
        // Bloom just before / as the leaves break (calibrated, same forcing
        // sum from Feb 1 and chilling penalty as leaf-out): early-mid April
        // at Rennes; the mean onset of cherry bloom in Germany was 17 April
        // in 1991-2020 (Deutscher Wetterdienst phenological network), a
        // cooler climate.
        bloom_gdd: 172.0,
        bloom_duration_gdd: 110.0,
        // Umbels of 2-6 flowers on short spurs of 2-year and older wood,
        // throughout the outer crown (bloom reads as a white cloud; only the
        // deep-shaded interior is bare).
        min_wood_age_years: 2,
        min_light: 0.2,
        max_wood_radius_mm: 25.0,
        flower_density: 3.5,
        flower_cluster_cm: 6.0,
        fruit_cluster_cm: 4.0,
        flower_color: (0.97, 0.96, 0.92),
        // Self-incompatible, insect-pollinated: a third of the umbels set
        // fruit in a good year.
        fruit_set: 0.35,
        // Open flowers are killed around -2 degC (Rodrigo 2000).
        flower_frost_c: -2.2,
        // Fruits ripen ~9 weeks after bloom (June - early July), then are
        // taken by birds within a few weeks.
        fruit_ripening_days: 60.0,
        fruit_persistence_days: 18.0,
        fruit_color_unripe: (0.45, 0.62, 0.22),
        fruit_color_ripe: (0.50, 0.04, 0.07),
    ),
    // Short-lived pioneer: vigour declines from ~85 years (heart rot,
    // cankers), the tree is senescent by ~120-130 years.
    longevity: (
        decline_onset_years: 85.0,
        decline_years: 40.0,
        decline_min_vigour: 0.3,
    ),
    // Prunus (Rosaceae) forms arbuscular mycorrhizae, the ancestral and
    // dominant type (Wang & Qiu 2006, Mycorrhiza 16:299-363); wild cherry is
    // colonised by Glomus spp. (Lovato et al. 1994, "Mycorrhization of
    // micropropagated mature wild cherry (Prunus avium L.) and common ash",
    // Agricultural Science in Finland). AM hyphae can supply most of the plant's
    // P and a smaller part of its N (Marschner & Dell 1994, Plant Soil
    // 159:89-102); the shares here are calibrations. AM fungi receive a few
    // to ~20 % of the host's photosynthate (Smith & Read 2008, Mycorrhizal
    // Symbiosis, 3rd ed.); 10 % of NPP here. Extraradical AM hyphae stay
    // within a few cm of the root (drawn reach exaggerated for legibility).
    symbiosis: (
        mycorrhiza: Arbuscular,
        carbon_cost: 0.10,
        phosphorus_share: 0.7,
        nitrogen_share: 0.2,
        water_share: 0.03,
        hyphal_reach_m: 0.12,
    ),
    // Response to pruning (see crates/dendro-core/src/pruning.rs). Wild
    // cherry has few viable latent buds and coppices poorly; it regenerates
    // by root suckers instead (EuroCoppice silviculture guidelines; Pryor
    // 1988, Forestry Commission Bulletin 75). Its winter wounds are the
    // entry point of silver leaf (Chondrostereum purpureum, spores Sept-May,
    // RHS advice) and bacterial canker (Pseudomonas syringae; Kennelly et
    // al. 2007, Plant Dis 91:4-17), so it is pruned in summer. Wounds
    // gum and compartmentalise less well than oak's (calibration). All
    // numbers are calibrations chosen for these qualitative rankings.
    pruning: (
        epicormic_potential: 0.2,
        sprout_vigour: 1.4,
        stump_sprouting: 0.35,
        root_suckering: 0.8,
        compensatory_growth: 0.25,
        woundwood_ratio: 1.8,
        compartmentalization: 0.45,
        decay_infection_rate: 0.08,
        decay_axial_m_per_year: 0.12,
        decay_radial_mm_per_year: 8.0,
        pathogen_dormant_risk: 0.45,
        pathogen_summer_risk: 0.04,
        pathogen_dieback_years: 3.0,
        reserve_in_branches: 0.3,
        root_balance_rate: 0.4,
        sap_bleeding: 0.2,
        // Wild cherry is short-lived (rarely much over 100 years).
        typical_lifespan_years: 110.0,
    ),
    // Static mechanics (crates/dendro-core/src/mechanics.rs; read-only, no
    // effect on growth). No green-wood table for P. avium was available:
    // the values are those of black cherry (Prunus serotina) in the USDA
    // Wood Handbook (FPL-GTR-190, 2010), a proxy.
    mechanics: (
        // Table 4-1: green moisture content of black cherry heartwood 58 %
        // (sapwood not given); Table 5-3a: specific gravity 0.47 (green
        // volume). 0.47 x 1.58 = 743 kg/m3 (heartwood: sapwood, wetter, is
        // heavier; underestimate).
        green_density_kg_m3: 743.0,
        // Table 5-3a, black cherry, green: MOR 55 000 kPa, MOE 9 000 MPa.
        green_mor_mpa: 55.0,
        green_moe_gpa: 9.0,
        // Vollsinger et al. 2005 (Can J For Res 35:1238-1249): 0.15-0.22 at
        // 20 m/s on the still-air frontal area (no cherry measured):
        // estimated, same as oak.
        crown_drag_coefficient: 0.2,
        // Same study: drag ~ U^1 (B = -1) over 4-20 m/s; estimated.
        vogel_exponent: -1.0,
        // ForestGALES 2.5, Sitka spruce, freely draining, deep rooting
        // (conifer proxy, estimated). The shallower, spreading root system
        // of cherry acts through the simulated rooting depth, not here.
        anchorage_nm_per_kg: 178.1,
    ),
)
