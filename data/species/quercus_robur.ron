// Pedunculate oak, Quercus robur L.
// Values are literature-plausible orders of magnitude, some calibrated so the
// emergent tree matches open-grown oak sizes (marked "calibrated").
// Sources (full list in docs/sources.md): Jones 1959, "Biological Flora of
// the British Isles: Quercus L.", J Ecol 47:169-222 (general ecology of
// Q. robur); Kutschera & Lichtenegger 2002 (roots); Cannell & Smith 1983 and
// Delpierre et al. 2009 (phenology); Parelle et al. 2006 (waterlogging).
// Where a number has no direct source it is marked "stylised" or "calibrated".
(
    species: "Quercus robur",
    common_name: "Pedunculate oak",
    common_name_fr: "Chêne pédonculé",
    // Menu group (no effect on growth).
    category: Broadleaf,
    architecture: (
        // Borchert-Honda lambda of the stem (Borchert & Honda 1984, "Control
        // of development in the bifurcating branch system of Tabebuia rosea:
        // a computer simulation", Bot Gaz 145:184-195; the lambda values here
        // are calibrated by eye, not measured). Oak is excurrent when
        // young (strong apical control keeps basal shoots from becoming
        // co-dominant stems), strongly decurrent when mature: below 0.5 the
        // laterals out-compete the leader and the stem dissolves into a few
        // large ascending limbs (broad, rounded dome).
        apical_dominance_young: 0.75,
        apical_dominance_mature: 0.42,
        maturity_age_years: 50.0,
        // Limbs keep a moderate apical control (they extend as axes with
        // side branches, rather than dissolving into fans).
        apical_dominance_branches: 0.52,
        // Young oaks keep a dominant leader for their first ~15 years
        // (excurrent juvenile phase), then lambda declines smoothly until
        // maturity_age_years.
        juvenile_phase_years: 15.0,
        // Branch-to-branch competition for vigour (stylised, calibrated by
        // eye): the best-lit limbs take more than their proportional share,
        // so the crown is carried by ~5-9 massive scaffold limbs instead of
        // many similar stems.
        lateral_competition: 3.0,
        // Metamers per unit light (calibrated).
        vigour_per_light: 5.7,
        bud_break_threshold: 1.0,
        // Oak internodes on vigorous shoots ~3-5 cm (typical value, no
        // specific source checked).

        internode_length_m: 0.045,
        // Vigorous oak leaders reach 0.5-0.8 m/yr (first flush only, no lammas).
        max_shoot_length_m: 0.5,
        // Oak buds cluster at the shoot tip (3-5 lateral buds around the terminal).
        lateral_buds_per_shoot: 4,
        lateral_buds_per_metamer: 0.4,
        bud_lifetime_years: 3,
        // Wide-angled, spreading limbs.
        branching_angle_deg: 52.0,
        // Quercus has 2/5 phyllotaxis (144 deg).
        phyllotaxis_deg: 144.0,
        // Branching order cap. Effectively unlimited: with level-of-detail shoot
        // units, orders keep increasing over centuries.
        max_order: 120,
        // Leader orthotropic; laterals corrected towards their set-points.
        gravitropism: 0.35,
        lateral_gravitropism: 0.3,
        // Gravitropic set-points (concept: Digby & Firn 1995, "The
        // gravitropic set-point angle (GSA)...", Plant Cell Environ
        // 18:1434-1440, doi:10.1111/j.1365-3040.1995.tb00205.x; values
        // calibrated by eye): lower limbs of open-grown oak run out at
        // 60-70 deg from vertical, upper ones ascend; twigs spread outward.
        limb_setpoint_low_deg: 60.0,
        limb_setpoint_high_deg: 30.0,
        twig_setpoint_deg: 65.0,
        // Open-grown oak crowns are about as wide as tall (0.8-1.2): limb
        // tips turn up beyond ~0.6 x the corresponding crown radius
        // (stylised cap on spread).
        crown_spread_ratio: 1.15,
        // Weight of growth towards the brightest sky sector (kept low: the
        // set-points, not the sky, set the limb angles).
        phototropism: 0.12,
        // Small random deviation per annual shoot (stylised).
        sinuosity_deg: 8.0,
        // Oak's zigzag, "elbowed" limbs: frequent loss of the terminal bud
        // with relay by a subterminal bud (stylised rate and angle).
        leader_loss_probability: 0.25,
        leader_loss_angle_deg: 22.0,
        // Branch sag under load (stylised, calibrated by eye): only limbs
        // thicker than ~8 cm, at most 8 deg in total along any path from the
        // stem and never more than 10 deg below horizontal, so old lower
        // limbs run out flat and their young tips turn up.
        sag_coefficient: 3.0,
        sag_min_radius_mm: 40.0,
        sag_max_deg_per_year: 0.4,
        sag_max_total_deg: 8.0,
        sag_max_droop_deg: 10.0,
        sag_min_inclination_deg: 50.0,
        // Autotropic straightening of limbs that were continued by a lateral
        // (stylised rate): limbs > 2.5 cm radius straighten by up to
        // 1.5 deg/yr, keeping 12 deg of their elbows (sinuous, not kinked).
        // Calibration: the radius gate was 15 mm while the simulated wood
        // was ~1.5 x too thin in youth; with the wood budget (growth.rs,
        // `area_per_foliage`) the same axes are now ~25 mm thick, and
        // keeping 15 mm straightened more axes (+0.7 m height, -0.06 W/H
        // at 200 y). Raised again from 25 to 40 mm when the adaptive
        // radial growth (wood traits) thickened the limbs: at 25 mm the
        // crown narrowed (W/H at 100 y 0.91 on seed 1) and the scaffold
        // count rose to 11; of 25, 30, 35 and 40 mm, only 40 kept every
        // architecture test of tests/simulation.rs and tests/cherry.rs
        // (seed-sensitive single-tree checks) in its band.
        straightening_deg_per_year: 1.5,
        straightening_keep_deg: 12.0,
        straightening_min_radius_mm: 40.0,
        // Shade tolerance and self-pruning: no direct source; thresholds are
        // calibrated. Oak is light-demanding, but shade leaves of the lower and inner
        // crown persist down to ~9 % of open-sky light (calibrated; with the
        // 3-year survival below), so the open-grown crown stays deep.
        shedding_threshold: 0.09,
        // Shaded branches live a few years on reserves before dying.
        shade_survival_years: 3,
        // Mean-light shedding disabled for oak (it collapses the open crown
        // with this light model); kept for other species.
        shedding_mean_threshold: 0.0,
        // Open-grown oak: clear bole ~10-20 % of height, rarely above 4-5 m
        // (stylised natural pruning, see genome.rs).
        clear_bole_fraction: 0.15,
        clear_bole_max_m: 4.0,
        clear_bole_limb_ratio: 0.5,
        // Crown retrenchment of veteran oaks (stylised rates): from ~200 y
        // the farthest boughs die back (stag-headed top, dead limbs that
        // break up over decades) while epicormic shoots rebuild a lower
        // inner crown ("growing downwards", Lonsdale (ed.) 2013, "Ancient and other
        // veteran trees: further guidance on management", The Tree Council,
        // London; the onset age and the rates below are stylised).
        retrenchment_onset_years: 200.0,
        retrenchment_rate: 0.08,
        // Dieback probability ramps up over a century after onset.
        retrenchment_ramp_years: 100.0,
        retrenchment_reach: 0.72,
        epicormic_rate: 0.04,
        // Collar-to-bud distance (m) where extension stops; calibrated so
        // open-grown height reaches ~30 m at 200 years.
        hydraulic_path_max_m: 37.0,
        // Height growth stays vigorous to mid-life, then plateaus (calibrated).
        hydraulic_exponent: 1.8,
        // Foliage efficiency declines with transport distance (stylised;
        // drives the age decline of basal area increment). Calibration:
        // was 0.65 (an early, gradual decline); raised to 1.2 with
        // `wood.growth_coefficient` when the adaptive radial growth of the
        // limbs began to take wood from the stem of the old tree, so that
        // the stem follows White 1998 again at 40-200 y.
        hydraulic_foliage_exponent: 1.2,
    ),
    leaf: (
        // Leaves 7-14 cm long, 4-7 lobes per side, very short petiole.
        length_cm: 10.0,
        width_cm: 6.0,
        lobes: 10,
        // Lobed but entire (not toothed) margin.
        serration: 0.0,
        deciduous: true,
        // Young oaks often keep dead brown leaves on lower branches in winter.
        marcescence: 0.5,
        marcescence_max_age_years: 30.0,
        // ~5-9 leaves per annual shoot, crowded at its tip (the terminal
        // bud cluster), on very short petioles, held forward.
        leaves_per_shoot: 7.0,
        // Rendering: oak leaves bunch at shoot tips into dense tufts;
        // dense, heavy crown.
        cluster_size_leaves: 3.0,
        foliage_density: 5.0,
        tip_bunching: 0.75,
        petiole_ratio: 0.06,
        leaf_droop: 0.15,
        // Short shoots (brachyblasts) and epicormic twigs keep the inner
        // crown and the limbs leafy (oak is moderately shade tolerant).
        spur_foliage: 4.0,
        spur_max_radius_mm: 40.0,
        spur_min_light: 0.05,
        // Oak turns slowly and patchily over about a month.
        colour_spread: 0.55,
    ),
    pigments: (
        chlorophyll: 1.0,
        // Autumn oak foliage is yellow-brown, little red.
        carotenoids: 0.55,
        anthocyanins: 0.12,
        tannins: 0.9,
    ),
    phenology: (
        // Budburst: T = a + b exp(-3 C / chilling_requirement_days), T in
        // degC.day > 5 degC from Feb 1, C = days with mean <= 5 degC from
        // Nov 1 (Cannell & Smith 1983, J Appl Ecol 20:951-963; fitted per
        // species, Q. robur included, by Murray, Cannell & Smith 1989, J
        // Appl Ecol 26:693-700, who class oak among the species whose
        // forcing requirement depends little on chilling). Calibration: the
        // a, b and requirement values are ours, tuned so that budburst
        // falls in mid/late April in the Rennes climate (oak stands in
        // France leaf out from mid-April, Lebourgeois et al. 2010, Int J
        // Biometeorol 54:563-581; late April-early May across Europe, Eaton
        // et al. 2016, European Atlas of Forest Tree Species).
        // Recalibrated with the WGEN temperature generator (crate::tempgen): the
        // former climate had March 0.6 degC too cold and about half the
        // day-to-day variance, so the same thresholds now gave budburst
        // 6-10 days earlier (warmer March; with a wider spread, warm days add
        // forcing above 5 degC and cold days add chill days below 5 degC:
        // the two effects were not measured separately). Thresholds raised
        // to restore the earlier
        // calibrated mean dates (measured, 5 seeds x 40 years: oak
        // budburst day 113.2 before / 112.8 after; cherry 103.3 / 102.6,
        // cherry bloom 101.6 / 100.5, 0-based).
        // gdd_budburst was 270.
        chilling_requirement_days: 45.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 308.0,
        chill_forcing_gdd: 130.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 190.0,
        // Senescence after Delpierre et al. 2009 (Agric For Meteorol
        // 149:938-948; photoperiod gate + cold sum; parameter values here are
        // calibrated to the stated dates, not copied from their fits):
        // colouring from late September, half-coloured mid-October (French
        // oak stands yellow in mid-October, Lebourgeois et al. 2010), full
        // colour early-mid November, bare by ~29 November (gate was 11.6 h,
        // which with the Rennes climate left oaks leafy into December).
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 17.0,
        senescence_cdd: 190.0,
        leaf_fall_days: 21.0,
    ),
    wood: (
        // Q. robur basic density ~ 0.55-0.65 g/cm3 (load of the sag model;
        // typical handbook range, not individually sourced).

        density_kg_m3: 640.0,
        // Green oak MOE ~ 8-10 GPa.
        elasticity_gpa: 9.0,
        // Oak is the textbook ring-porous wood: large earlywood vessels formed
        // at budburst from reserves; latewood carries climate variability
        // (Barbaroux & Breda 2002, Tree Physiol 22:1201-1210, for the
        // reserve use; see also rings.rs).

        ring_porous: true,
        earlywood_share: 0.35,
        // Renderer: strong ring contrast (wide band of large earlywood pores).
        ring_contrast: 1.0,
        // Durable heartwood: dead oak limbs stand for decades (a 10 cm
        // radius bough ~50 years; stylised).
        snag_years_per_m: 500.0,
        // Wood volume made per unit of light-weighted foliage in an average
        // year (m3/m2), spread over the shoot system by Pressler's law
        // (growth.rs, `area_per_foliage`). Calibration: fitted to White
        // 1998 (FC Information Note 12, Tables 1a-2), common oak "good
        // site, open grown": 4 mm core rings to 80 y (DBH 32 cm @40,
        // 48 @60), then CAI ~80 cm2/y (78 cm @100, 106 @150, 128 @200).
        // Model (seeds 42, 1, 1234; median): 33, 49, 80, 109, 130 cm.
        // Refitted with `hydraulic_foliage_exponent` when the adaptive
        // radial growth below started to take its share of the budget
        // for the limbs (it was 0.000465 with exponent 0.65; kept as is,
        // the old tree's stem fell to ~70 cm @100 and ~92 @150). Was
        // 2.0e-5 m2 of area per foliage, which left the stem thin before
        // ~100 y (20 cm @40).
        growth_coefficient: 0.00038,
        twig_radius_mm: 2.5,
        max_ring_width_mm: 9.0,
        // Mesh-only stylisation (not measured): visible branch collars, and
        // the strong root flare of old oaks with a few buttress lobes over
        // the main lateral roots.
        collar_flare: 0.25,
        // Branching exponent for drawn radii. Leonardo's rule (sum of
        // daughter areas ~ parent area, exponent 2): Eloy 2011, "Leonardo's
        // rule, self-similarity, and wind-induced stresses in trees", Phys
        // Rev Lett 107:258101, doi:10.1103/PhysRevLett.107.258101 (exponents
        // between ~1.8 and 2.3 reported across species); da Vinci's rule
        // holds approximately in field data (Minamino & Tateno 2014, "Tree
        // branching: Leonardo da Vinci's rule versus biomechanical models",
        // PLoS ONE 9:e93535; Fagus crenata, Abies homolepis). No measurement
        // for Q. robur was found. Calibration: the upper end of the range
        // (the oak's thick, sympodial limbs); it was 2.6, outside it.
        pipe_exponent: 2.3,
        // Cap of the drawn widening (with e = 2.3 the factor stays below
        // ~1.3 on limbs, so the cap rarely binds); twigs keep their
        // simulated radius. Since the adaptive radial growth below, the
        // simulated limbs are thicker than the pipe model at their base
        // (area ratio ~1.1 at the insertions of the old oak's limbs); the
        // drawn widening is kept on top of it (checked by eye on the
        // 150-year winter crown, not measured).
        limb_draw_boost: 1.6,
        // Old oak limbs and stems are fluted and out of round.
        bark_irregularity: 0.07,
        // Adaptive radial growth (growth.rs, `ShootSystem::adaptive_demand`):
        // a woody segment whose bending stress under its own weight (green
        // wood + summer leaves, as in mechanics.rs) exceeds the set-point
        // gets the extra wood that brings it back to it, taken from the
        // year's budget. Set-point: the mean self-weight bending stress of
        // primary branches over 40 woody species, 11.1 MPa (species means
        // 5.2-18.9 MPa, SD 3.3), roughly constant along each branch (Evans,
        // Kahn-Jetter, Torres, Martinez & Tarsia 2008, "Mechanical stresses
        // of primary branches: a survey of 40 woody tree and shrub
        // species", Trees 22:283-289, doi:10.1007/s00468-007-0182-7;
        // abstract read, oak not identified among the species). With the
        // green MOR of 57 MPa this is a safety of ~5 under self-weight.
        // The same value is used for both species (no species value).
        adaptive_stress_mpa: 11.1,
        // Estimated: twigs and small branches (< 5 cm, the structural limb
        // threshold of mechanics.rs) bend under load rather than thicken.
        adaptive_min_diameter_cm: 5.0,
        // Estimated safety valve: the response may take at most 30 % of a
        // growth phase's wood budget. Measured on an intermediate
        // calibration (straightening gate still 25 mm), 150-year oak:
        // between 0.2 and 1.0 the DBH moves by ~1 %, the lowest limb
        // safety from 4.5-4.9 (0.2) to 5.0-5.1 (1.0).
        adaptive_max_budget_share: 0.3,
        root_flare: 0.7,
        root_flare_height_radii: 2.5,
        buttress_lobes: 5,
    ),
    // Bark appearance (renderer only): grey-brown, with deep vertical
    // fissures and ridges from ~20-30 years, no lenticel bands; current-year
    // shoots olive green-brown; old trunks darker.
    bark: (
        color: (0.40, 0.32, 0.28),
        young_color: (0.40, 0.38, 0.22),
        old_darkening: (0.10, 0.08, 0.06),
        lenticels: 0.0,
        fissures: 0.85,
        gloss: 0.0,
    ),
    roots: (
        // Oak forms a strong taproot in the first years (often > 1 m by
        // 5 years), which loses dominance within a few decades to a "heart"
        // system of laterals and sinkers (Kutschera & Lichtenegger 2002;
        // Lucot & Bruckert 1992 for mature Q. robur, see lateral_spread).
        taproot_dominance: 0.9,
        taproot_decline_years: 12.0,
        // Genetic maximum rooting depth; the soil usually stops roots first
        // (oak: 2-3 m on loam, 4-5 m on deep sand; Stone & Kalisz 1991, For
        // Ecol Manage 46:59-102; the split by soil is a summary, not a table
        // value we checked).
        max_depth_m: 4.5,
        // Lateral spread as a multiple of crown radius. Lucot & Bruckert
        // 1992 ("Organisation du systeme racinaire du chene pedoncule
        // (Quercus robur) developpe en conditions edaphiques non
        // contraignantes", Ann Sci For 49:465-479, doi:10.1051/forest:19920503)
        // found 150-year-old Q. robur rooting intensively within ~3 m of the
        // stem (surface system 0-0.6 m), with sub-vertical sinkers below 4 m
        // and extensive roots reaching ~20 m from the tree. Calibration: 1.4
        // x the (open-grown, wide) crown radius gives ~22 m at 150 years
        // (it was 2.2, i.e. ~35 m, beyond that observation); their stand
        // trees had narrower crowns, so the ratio itself is uncertain.
        lateral_spread: 1.4,
        lateral_count: 8,
        // Preferred depth of the main laterals (they run 0.3-1 x this deep).
        lateral_depth_m: 0.45,
        sinker_tendency: 0.25,
        branching_probability: 0.3,
        max_order: 3,
        annual_extension_m: 0.9,
        // Oak roots penetrate dense subsoil well (stylised; growth stops
        // around 3 MPa for most species).
        max_penetration_mpa: 3.2,
        // Q. robur tolerates waterlogging better than Q. petraea (Parelle et
        // al. 2006, Ann For Sci 63:849-859, seedlings) but its roots still avoid permanently anoxic soil.
        waterlogging_tolerance: 0.4,
        // Q. robur roots tolerate hypoxia well (hypertrophied lenticels,
        // adventitious roots; Parelle et al. 2006; Colin-Belgrand, Dreyer &
        // Biron 1991, Ann Sci For 48:193-204, seedlings of Q. robur, Q.
        // rubra, Q. palustris): treated as fully
        // tolerant of poorly aerated, non-saturated soil.
        hypoxia_sensitivity: 0.0,
        // Moderate deepening after dry years (stylised).
        drought_deepening: 0.6,
        hydrotropism: 0.4,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.8,
        // Fine roots per metre of structural root (stylised; gives topsoil
        // root length densities of a few km/m3 as measured under oak).
        fine_root_per_m: 1000.0,
        // Mesh: strong taper of laterals within 1-2 m of the stem.
        rapid_taper: 1.2,
    ),
    tolerances: (
        // New oak foliage is killed around -3 degC (Eaton et al. 2016,
        // "Quercus robur and Quercus petraea in Europe", European Atlas of
        // Forest Tree Species).
        frost_c: -3.0,
        // Q. robur is moderately drought tolerant (less than Q. petraea).
        drought: 0.45,
        // Light-demanding pioneer-ish species.
        shade: 0.3,
    ),
    reproduction: (
        // Open-grown oak bears acorns from ~30-40 years (later in stands).
        first_flowering_age_years: 35.0,
        // Wind-pollinated: green-yellow male catkins and tiny female flowers,
        // inconspicuous at tree scale; acorns are not drawn either.
        flower_display: 0.0,
        fruit_display: 0.0,
        // Catkins open with the leaves (raised from 260 with the WGEN
        // climate, like gdd_budburst: mean bloom day 112.5 vs budburst 112.8).
        bloom_gdd: 298.0,
        bloom_duration_gdd: 120.0,
        // Flowers on the current-year shoots.
        min_wood_age_years: 0,
        min_light: 0.3,
        max_wood_radius_mm: 30.0,
        flower_density: 1.0,
        flower_cluster_cm: 6.0,
        fruit_cluster_cm: 3.0,
        flower_color: (0.65, 0.62, 0.30),
        fruit_set: 0.3,
        flower_frost_c: -2.5,
        // Acorns ripen in late September-October and fall soon after.
        fruit_ripening_days: 140.0,
        fruit_persistence_days: 20.0,
        fruit_color_unripe: (0.35, 0.45, 0.15),
        fruit_color_ripe: (0.45, 0.32, 0.15),
    ),
    // Oak lives for centuries: no programmed decline (veteran crowns
    // retrench instead, see architecture).
    longevity: (
        decline_onset_years: 0.0,
        decline_years: 50.0,
        decline_min_vigour: 0.3,
        // Carbon balance of ageing (crates/dendro-core/src/vitality.rs):
        // maintenance of the living wood per metre of collar-to-leaf
        // distance, relative to the production of the same foliage.
        // Calibrated: no measured value exists; tuned (seeds 1-5) so that
        // the trunk dies, emergently, within the published longevity,
        // 500-1000 y (wikipedia DE): beyond the 400-year bench run (data/validation/quercus_robur.ron).
        // Set low enough that the cost stays below ~75 % of production
        // within 400 years (only censored runs can be checked).
        // While > 0 the age-scheduled decline_* values above are ignored.
        maintenance_per_m: 0.0014,
    ),
    // Oaks are ectomycorrhizal (mantle + Hartig net; Smith & Read 2008,
    // "Mycorrhizal Symbiosis", 3rd ed., Academic Press). Carbon cost: Hobbie
    // 2006, Ecology 87:563-569, doi:10.1890/05-0755 (1-21 % of NPP to
    // ectomycorrhizal fungi in culture studies; 15 % here, calibration
    // within that range). Nutrient / water shares and the drawn reach of the
    // extramatrical mycelium (medium- to long-distance exploration types,
    // Agerer 2001, Mycorrhiza 11:107-114, doi:10.1007/s005720100108) are
    // calibrations, not measurements. Used by the flux view only.
    symbiosis: (
        mycorrhiza: Ecto,
        carbon_cost: 0.15,
        phosphorus_share: 0.6,
        nitrogen_share: 0.4,
        water_share: 0.05,
        hyphal_reach_m: 0.35,
    ),
    // Response to pruning (see crates/dendro-core/src/pruning.rs for the
    // model and its references). Pedunculate oak releases latent buds
    // abundantly after pruning, thinning or topping (epicormic shoots,
    // Meier, Saunders & Michler 2012, Tree Physiol 32:565-584; Fontaine et
    // al. 2001, Ann For Sci 58:583-592 on Quercus petraea) and coppices
    // readily (traditional oak coppice and pollards, Read 2000). Durable
    // heartwood and good compartmentalisation (Shigo 1984). Oak pathogens
    // entering pruning wounds are a minor risk in Europe (no oak wilt).
    // All numbers are calibrations chosen for these qualitative rankings.
    pruning: (
        epicormic_potential: 0.9,
        sprout_vigour: 2.2,
        stump_sprouting: 0.85,
        root_suckering: 0.0,
        compensatory_growth: 0.35,
        woundwood_ratio: 2.2,
        compartmentalization: 0.7,
        decay_infection_rate: 0.04,
        decay_axial_m_per_year: 0.06,
        decay_radial_mm_per_year: 5.0,
        pathogen_dormant_risk: 0.03,
        pathogen_summer_risk: 0.02,
        pathogen_dieback_years: 4.0,
        reserve_in_branches: 0.3,
        root_balance_rate: 0.3,
        sap_bleeding: 0.05,
        // Open-grown pedunculate oaks commonly live 500+ years.
        typical_lifespan_years: 600.0,
    ),
    // Static mechanics (crates/dendro-core/src/mechanics.rs; read-only, no
    // effect on growth). No green-wood table for Q. robur was available:
    // the values are those of white oak (Quercus alba, same white-oak
    // group) in the USDA Wood Handbook (FPL-GTR-190, 2010), a proxy.
    mechanics: (
        // Table 4-1: green moisture content of white oak 64 % (heartwood)
        // to 78 % (sapwood); Table 5-3a: specific gravity 0.60 (green
        // volume). 0.60 x 1.64 = 984 to 0.60 x 1.78 = 1068 kg/m3; mean.
        green_density_kg_m3: 1026.0,
        // Table 5-3a, white oak, green: MOR 57 000 kPa, MOE 8 600 MPa.
        green_mor_mpa: 57.0,
        green_moe_gpa: 8.6,
        // Vollsinger et al. 2005 (Can J For Res 35:1238-1249): crown drag
        // coefficients of 0.15-0.22 at 20 m/s on the still-air frontal
        // area (three hardwoods; no oak measured): value in that range,
        // estimated.
        crown_drag_coefficient: 0.2,
        // Same study: drag proportional to crown mass x wind speed, i.e.
        // U^1 (B = -1) over 4-20 m/s. Not measured on oak: estimated.
        vogel_exponent: -1.0,
        // ForestGALES 2.5 (Forest Research), Sitka spruce, freely draining
        // soil, deep rooting: Creg = 178.1 N m/kg, refitted from Nicoll et
        // al. 2006. No broadleaf tree-pulling coefficient was found: conifer
        // value used as an estimate (docs/sources.md, « Écarts connus »).
        anchorage_nm_per_kg: 178.1,
    ),
)
