// Apple, Malus domestica Borkh. Pilot fruit tree of the species registry.
//
// WHAT IS SIMULATED: an own-rooted seedling tree ("franc de pied",
// "plein vent", standard/high-stem cider apple on seedling rootstock),
// growing freely, never pruned unless the player prunes it. No grafting:
// a dwarfing rootstock (M9 = 40-45 % of the seedling's size [ars_size_m9])
// would be a second genome for the roots and a vigour factor on the scion,
// which the engine does not have; orchard training (spindle, palmette) is
// not modelled either. The bench marks the "VERGER greffé" reference
// entries as not comparable for that reason.
//
// Reference values: data/validation/malus_domestica.ron (ids in brackets)
// and docs/species/malus_domestica.md. Status: "measured" (published value
// read by the research agent), "proxy", "estimated", "calibrated".
(
    species: "Malus domestica",
    common_name: "Apple",
    common_name_fr: "Pommier",
    category: FruitTree,
    architecture: (
        // Spreading, rounded crown; the wild apple is often bushy
        // [euforgen_sylvestris_height]. Hallé-Oldeman model not stated in a
        // source read (trait sheet): not claimed. Apical control:
        // estimated, a short excurrent youth then a decurrent, globular crown.
        apical_dominance_young: 0.62,
        apical_dominance_mature: 0.42,
        maturity_age_years: 25.0,
        juvenile_phase_years: 8.0,
        apical_dominance_branches: 0.5,
        lateral_competition: 1.8,
        // Calibrated (8-15 m free-standing crown [de_wiki_freestanding_height]).
        vigour_per_light: 6.0,
        bud_break_threshold: 1.0,
        internode_length_m: 0.03,
        max_shoot_length_m: 0.55,
        lateral_buds_per_shoot: 5,
        lateral_buds_per_metamer: 0.3,
        bud_lifetime_years: 4,
        // Wide crotch angles; Rosaceae 2/5 phyllotaxis (estimated).
        branching_angle_deg: 55.0,
        phyllotaxis_deg: 144.0,
        max_order: 120,
        gravitropism: 0.45,
        lateral_gravitropism: 0.3,
        limb_setpoint_low_deg: 70.0,
        limb_setpoint_high_deg: 50.0,
        twig_setpoint_deg: 70.0,
        // Broad, rounded crown, about as wide as tall (calibrated).
        crown_spread_ratio: 1.7,
        phototropism: 0.12,
        sinuosity_deg: 9.0,
        // Terminal buds often end in a flower cluster (fruit on short
        // shoots, trait sheet): frequent relays, crooked limbs (estimated).
        leader_loss_probability: 0.15,
        leader_loss_angle_deg: 30.0,
        // Fruit-laden limbs bend: a stronger sag than the cherry's
        // (stylised; no fruit load is simulated).
        sag_coefficient: 5.0,
        sag_min_radius_mm: 25.0,
        sag_max_deg_per_year: 0.8,
        sag_max_total_deg: 14.0,
        sag_max_droop_deg: 15.0,
        sag_min_inclination_deg: 45.0,
        straightening_deg_per_year: 1.0,
        straightening_keep_deg: 10.0,
        straightening_min_radius_mm: 30.0,
        // Light-demanding [euforgen_light_demand]: shaded inner wood dies.
        shedding_threshold: 0.10,
        shade_survival_years: 2,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.15,
        clear_bole_max_m: 2.0,
        clear_bole_limb_ratio: 0.5,
        // Lifespan 80-100 y (standard trees [arche_noah_longevity],
        // wild apple [euforgen_sylvestris_longevity]): crown dieback from
        // ~70 y (estimated).
        retrenchment_onset_years: 70.0,
        retrenchment_rate: 0.10,
        retrenchment_ramp_years: 30.0,
        retrenchment_reach: 0.6,
        epicormic_rate: 0.03,
        hydraulic_path_max_m: 14.0,
        hydraulic_exponent: 1.2,
        hydraulic_foliage_exponent: 1.2,
    ),
    leaf: (
        // 5-12 x 3-6 cm, serrate, petiole 1-3.5 cm (Wikipedia it/en, trait
        // sheet), no marcescence.
        length_cm: 8.0,
        width_cm: 5.0,
        lobes: 0,
        serration: 0.5,
        deciduous: true,
        marcescence: 0.0,
        marcescence_max_age_years: 1.0,
        leaves_per_shoot: 8.0,
        cluster_size_leaves: 3.0,
        foliage_density: 4.0,
        tip_bunching: 0.3,
        petiole_ratio: 0.3,
        leaf_droop: 0.4,
        // Leaf rosettes of spurs and "bourses" on 2+ year wood (trait sheet).
        spur_foliage: 6.0,
        spur_max_radius_mm: 40.0,
        spur_min_light: 0.1,
        colour_spread: 0.5,
    ),
    // Calibration by eye: yellow autumn colour, little red.
    pigments: (
        chlorophyll: 1.0,
        carotenoids: 0.8,
        anthocyanins: 0.3,
        tannins: 0.5,
        anthocyanin_persistence: 0.0,
    ),
    phenology: (
        // High chilling requirement: 1000-1600 h below 7 degC (CFIA via
        // Wikipedia fr [fr_wiki_chill_hours]); cultivars 218-1423 h. Same
        // Cannell & Smith model as the others; calibrated so that bloom
        // falls at the start of May (pollination groups: 1-3 May for the
        // earliest to 24-28 May [en_wiki_pollination_group_*]; "May" in
        // central Europe [de_wiki_bloom_may]), leaves just before.
        chilling_requirement_days: 60.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 330.0,
        chill_forcing_gdd: 250.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 190.0,
        // As the oak (estimated): leaves fall late October - November.
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 17.0,
        senescence_cdd: 170.0,
        leaf_fall_days: 20.0,
    ),
    wood: (
        // Basic density 610 kg/m3 [wdb_apple_density_basic].
        density_kg_m3: 610.0,
        // MOE 8.76 GPa [wdb_apple_moe] (moisture not stated).
        elasticity_gpa: 8.8,
        // Diffuse-porous (trait sheet).
        ring_porous: false,
        earlywood_share: 0.4,
        ring_contrast: 0.25,
        // Calibrated: DBH 23-45 cm of the wild apple
        // [euforgen_sylvestris_dbh]; > 75 cm only on old exceptional trees
        // [de_wiki_dbh_record].
        growth_coefficient: 0.000360,
        twig_radius_mm: 2.5,
        max_ring_width_mm: 10.0,
        pipe_exponent: 2.2,
        limb_draw_boost: 1.3,
        bark_irregularity: 0.06,
        adaptive_stress_mpa: 11.1,
        adaptive_min_diameter_cm: 5.0,
        adaptive_max_budget_share: 0.3,
        collar_flare: 0.25,
        root_flare: 0.3,
        root_flare_height_radii: 1.5,
        buttress_lobes: 0,
        snag_years_per_m: 120.0,
    ),
    // Grey-brown bark flaking in thin plates on old trunks (estimated).
    bark: (
        color: (0.45, 0.38, 0.32),
        young_color: (0.48, 0.32, 0.24),
        old_darkening: (0.12, 0.10, 0.08),
        lenticels: 0.3,
        fissures: 0.5,
        gloss: 0.15,
    ),
    roots: (
        // No rooting depth found [absence_root_depth_apple]; "superficial"
        // (Wikipedia it). The seedling's taproot is assumed (trait sheet,
        // unsourced). All values estimated.
        taproot_dominance: 0.5,
        taproot_decline_years: 8.0,
        max_depth_m: 2.2,
        lateral_spread: 1.6,
        lateral_count: 9,
        lateral_depth_m: 0.4,
        sinker_tendency: 0.15,
        branching_probability: 0.35,
        max_order: 3,
        annual_extension_m: 0.8,
        max_penetration_mpa: 2.5,
        waterlogging_tolerance: 0.2,
        hypoxia_sensitivity: 0.5,
        hypoxia_air_porosity: 0.12,
        drought_deepening: 0.3,
        hydrotropism: 0.4,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.5,
        fine_root_per_m: 1000.0,
        rapid_taper: 1.0,
    ),
    tolerances: (
        // Young leaves: as the cherry's (estimated).
        frost_c: -2.0,
        drought: 0.4,
        // Very light-demanding [euforgen_light_demand]: 0.25 as the cherry
        // (estimated).
        shade: 0.25,
    ),
    reproduction: (
        // 8-10 y grafted on seedling rootstock, the closest to an
        // own-rooted seedling [de_wiki_seedling_rootstock_first_fruit].
        first_flowering_age_years: 9.0,
        flower_display: 1.0,
        fruit_display: 1.0,
        bloom_gdd: 390.0,
        bloom_duration_gdd: 120.0,
        // Fruit on short shoots (spurs, "bourses") of 2-year and older wood.
        min_wood_age_years: 2,
        min_light: 0.25,
        max_wood_radius_mm: 30.0,
        flower_density: 3.0,
        // Clusters of 3-7 flowers [wiki_flowers_per_cluster]; fruit 5-9 cm
        // [it_wiki_fruit_diameter] (cider apples smaller).
        flower_cluster_cm: 7.0,
        fruit_cluster_cm: 6.5,
        flower_color: (0.98, 0.90, 0.91),
        // 5 % of the flowers setting fruit gives a full crop (Wikipedia de,
        // trait sheet): a fifth of the clusters (estimated).
        fruit_set: 0.2,
        // Open flowers: 10 % killed at -2.2 degC, 90 % at -3.9 degC
        // [psu_apple_full_bloom_10] [psu_apple_full_bloom_90].
        flower_frost_c: -2.2,
        // Harvest September-October (estimated): ~4.5 months after bloom.
        fruit_ripening_days: 135.0,
        fruit_persistence_days: 35.0,
        fruit_color_unripe: (0.50, 0.66, 0.25),
        fruit_color_ripe: (0.74, 0.30, 0.12),
        fruit_kind: Fleshy,
        // Alternate bearing: strong / weak years 2:1 in British cider
        // orchards [cider_uk_biennial_ratio] (stylised: strict alternation,
        // off years at half the crop).
        crop_interval_years: 2.0,
        off_year_crop: 0.5,
    ),
    longevity: (
        decline_onset_years: 65.0,
        decline_years: 35.0,
        decline_min_vigour: 0.3,
    ),
    // Rosaceae: arbuscular mycorrhiza (Wang & Qiu 2006, Mycorrhiza
    // 16:299-363; no apple source read [absence_mycorrhiza_apple]); shares
    // as the cherry's (calibrations).
    symbiosis: (
        mycorrhiza: Arbuscular,
        carbon_cost: 0.10,
        phosphorus_share: 0.7,
        nitrogen_share: 0.2,
        water_share: 0.03,
        hyphal_reach_m: 0.12,
    ),
    // Strong reaction to heavy pruning (vertical water sprouts, trait
    // sheet); all values estimated.
    pruning: (
        epicormic_potential: 0.6,
        sprout_vigour: 1.6,
        stump_sprouting: 0.3,
        root_suckering: 0.1,
        compensatory_growth: 0.35,
        woundwood_ratio: 1.6,
        compartmentalization: 0.5,
        decay_infection_rate: 0.08,
        decay_axial_m_per_year: 0.1,
        decay_radial_mm_per_year: 6.0,
        pathogen_dormant_risk: 0.25,
        pathogen_summer_risk: 0.08,
        pathogen_dieback_years: 3.0,
        reserve_in_branches: 0.35,
        root_balance_rate: 0.4,
        sap_bleeding: 0.1,
        // 80-100 y [arche_noah_longevity].
        typical_lifespan_years: 90.0,
    ),
    mechanics: (
        // No green values found: estimated from basic density 610 with
        // ~60 % moisture content on dry mass.
        green_density_kg_m3: 980.0,
        // MOR 88.3 MPa and MOE 8.76 GPa [wdb_apple_mor] [wdb_apple_moe]
        // are not green values: green estimated at ~0.6 x MOR, ~0.85 x MOE
        // (typical green / 12 % ratios, estimated).
        green_mor_mpa: 53.0,
        green_moe_gpa: 7.4,
        crown_drag_coefficient: 0.2,
        vogel_exponent: -1.0,
        anchorage_nm_per_kg: 178.1,
    ),
)
