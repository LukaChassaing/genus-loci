// Norway spruce, Picea abies (L.) H. Karst. Pilot conifer of the species
// registry (evergreen needles, annual whorls, plagiotropic branches).
// Reference values: data/validation/picea_abies.ron (ids in brackets) and
// the trait sheet docs/species/picea_abies.md. Status of each value:
// "measured" (a published value read by the research agent), "proxy"
// (another species), "estimated" (general knowledge, no source read),
// "calibrated" (tuned so the emergent tree matches the references).
// No age-height-DBH table of OPEN-GROWN Norway spruce was found: size
// calibration rests on stand heights (Assmann-Franz table: mean height
// ~34 m at 100 y [utschig_h100_ass]), the leader growth record
// (up to 1 m/yr for 25 years [wen_leader_growth]) and the usual adult
// height 35-40 m [wfr_height]; see docs/sources.md, "Écarts connus".
(
    species: "Picea abies",
    common_name: "Norway spruce",
    common_name_fr: "Épicéa commun",
    category: Conifer,
    architecture: (
        // Monopodial, strongly excurrent stem all its life (no decurrent
        // switch; trait sheet, estimated): apical control stays high.
        apical_dominance_young: 0.80,
        apical_dominance_mature: 0.72,
        maturity_age_years: 150.0,
        juvenile_phase_years: 60.0,
        apical_dominance_branches: 0.62,
        lateral_competition: 1.4,
        // Calibrated (leader growth up to 1 m/yr, usually 0.3-0.8 m).
        vigour_per_light: 6.0,
        bud_break_threshold: 1.0,
        internode_length_m: 0.04,
        max_shoot_length_m: 0.70,
        // One whorl of 3-7 branches per annual shoot on the stem (Atlas:
        // "whorled, short and stout branches"; trait sheet), interwhorl
        // branchlets not modelled.
        lateral_buds_per_shoot: 5,
        lateral_buds_per_metamer: 0.4,
        bud_lifetime_years: 2,
        whorled: true,
        // Plagiotropic branches spreading as flat sprays (Massart's model
        // of Hallé, Oldeman & Tomlinson 1978 for Picea/Abies, from memory of
        // the book; the trait sheet says Rauh's model, "estimated" there).
        lateral_planarity: 0.55,
        branching_angle_deg: 72.0,
        phyllotaxis_deg: 137.5,
        max_order: 8,
        // Strongly orthotropic leader; upper whorls ascending, lower ones
        // drooping (Atlas: "the upper level ascending and the lower
        // drooping"). Set-points are calibrated by eye.
        gravitropism: 1.0,
        lateral_gravitropism: 0.35,
        limb_setpoint_low_deg: 100.0,
        limb_setpoint_high_deg: 60.0,
        twig_setpoint_deg: 95.0,
        // Conical crown (calibrated: width ~0.35-0.45 x height).
        crown_spread_ratio: 0.45,
        phototropism: 0.05,
        sinuosity_deg: 3.0,
        // A lost leader is relayed by an upturned whorl branch.
        leader_loss_probability: 0.02,
        leader_loss_angle_deg: 15.0,
        sag_coefficient: 4.0,
        sag_min_radius_mm: 20.0,
        sag_max_deg_per_year: 0.6,
        sag_max_total_deg: 15.0,
        sag_max_droop_deg: 25.0,
        sag_min_inclination_deg: 50.0,
        straightening_deg_per_year: 2.0,
        straightening_keep_deg: 5.0,
        straightening_min_radius_mm: 25.0,
        // Shade tolerant (Atlas [atlas_shade]): shaded branches live long;
        // an open-grown spruce keeps its branches to the ground (trait sheet).
        shedding_threshold: 0.04,
        shade_survival_years: 5,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.05,
        clear_bole_max_m: 1.0,
        clear_bole_limb_ratio: 0.3,
        // No stag-headed retrenchment modelled (mortality of old spruce is
        // wind, bark beetle and root rot, trait sheet).
        retrenchment_onset_years: 0.0,
        retrenchment_rate: 0.0,
        retrenchment_ramp_years: 100.0,
        retrenchment_reach: 1.0,
        epicormic_rate: 0.0,
        // Calibrated on the 35-40 m usual adult height.
        hydraulic_path_max_m: 40.0,
        hydraulic_exponent: 1.6,
        hydraulic_foliage_exponent: 1.0,
    ),
    leaf: (
        // Four-angled stiff needles 1-2.5 cm (Atlas [atlas_needle_length]).
        length_cm: 1.8,
        width_cm: 0.1,
        lobes: 0,
        serration: 0.0,
        deciduous: false,
        marcescence: 0.0,
        marcescence_max_age_years: 1.0,
        leaf_type: Needle,
        // Needles kept 5-7 years (Wikipedia fr [wfr_needle_longevity]),
        // 4-7 on healthy trees (Wikipedia de [wde_needle_longevity]).
        leaf_longevity_years: 6.0,
        // ~200 g/m2 (SLA 50 +- 17 cm2/g, 17-year stands [sla85_lma]; area
        // basis, projected or total, unknown). Same basis assumed for the
        // crown LAI, for which no reliable value was found (the generic 4
        // is kept, estimated).
        lma_g_m2: 200.0,
        crown_lai: 4.0,
        // Rendering: one card = a needled twig of ~15 cm.
        leaves_per_shoot: 60.0,
        cluster_size_leaves: 10.0,
        foliage_density: 3.0,
        tip_bunching: 0.0,
        petiole_ratio: 0.0,
        leaf_droop: 0.0,
        spur_foliage: 0.0,
        spur_max_radius_mm: 15.0,
        spur_min_light: 0.1,
        colour_spread: 0.3,
    ),
    // Calibration by eye: dark green needles; the cast cohort turns
    // yellow-brown.
    pigments: (
        chlorophyll: 1.3,
        carotenoids: 0.5,
        anthocyanins: 0.0,
        tannins: 0.5,
        anthocyanin_persistence: 0.0,
    ),
    phenology: (
        // Late budburst (Wikipedia fr, no date found; trait sheet): the
        // same chilling-forcing model as the oak (Cannell & Smith 1983, a
        // model fitted on Picea sitchensis), calibrated to leaf out about
        // three weeks after the oak at Rennes (estimated, no day of year
        // found for P. abies).
        chilling_requirement_days: 50.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 420.0,
        chill_forcing_gdd: 300.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        // Shoot elongation over ~5-6 weeks (estimated).
        leaf_expansion_gdd: 300.0,
        // For an evergreen these close the ring and drive the autumn cast
        // of the oldest needle cohort (estimated).
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 16.0,
        senescence_cdd: 150.0,
        leaf_fall_days: 40.0,
    ),
    wood: (
        // Basic density derived from 470 kg/m3 at 12-15 % (DIN 68364 via
        // Wikipedia de [wdeholz_dry12]) x ~0.84 (estimated conversion).
        density_kg_m3: 395.0,
        // Green MOE: red spruce (Picea rubens) proxy, USDA Wood Handbook
        // FPL-GTR-190 (2010), Table 5-3a.
        elasticity_gpa: 9.2,
        // Conifer wood: no vessels; distinct rings, light earlywood, dark
        // latewood (trait sheet).
        ring_porous: false,
        earlywood_share: 0.7,
        ring_contrast: 0.6,
        // Calibrated (no open-grown DBH table; see the header).
        growth_coefficient: 0.000420,
        twig_radius_mm: 2.0,
        max_ring_width_mm: 10.0,
        pipe_exponent: 2.0,
        limb_draw_boost: 1.1,
        bark_irregularity: 0.01,
        // Adaptive radial growth: same generic values as the oak (Evans et
        // al. 2008, mean over 40 species; no Picea value).
        adaptive_stress_mpa: 11.1,
        adaptive_min_diameter_cm: 5.0,
        adaptive_max_budget_share: 0.3,
        collar_flare: 0.15,
        // Shallow root plate: a flared, lobed collar (estimated).
        root_flare: 0.45,
        root_flare_height_radii: 1.5,
        buttress_lobes: 5,
        // Non-durable wood, but dead lower branches persist long (trait
        // sheet): moderate.
        snag_years_per_m: 250.0,
    ),
    // Thin, red-brown to grey bark in small scales (estimated).
    bark: (
        color: (0.40, 0.29, 0.24),
        young_color: (0.58, 0.40, 0.22),
        old_darkening: (0.10, 0.08, 0.07),
        lenticels: 0.0,
        fissures: 0.3,
        gloss: 0.05,
    ),
    roots: (
        // Shallow, spreading plate: an early taproot soon replaced by
        // laterals and sinkers (Atlas: "a shallow root system"); excavated
        // Finnish trees: max depth 1.62 m, max spread 10.1 m, 80 % of
        // coarse-root biomass in the top 30 cm [kall_depth] [kall_spread]
        // [kall_crb30]. Sinkers mostly from 60-80 y ([wde_sinker]: not modelled).
        taproot_dominance: 0.3,
        taproot_decline_years: 4.0,
        max_depth_m: 1.6,
        lateral_spread: 1.8,
        lateral_count: 12,
        lateral_depth_m: 0.25,
        sinker_tendency: 0.12,
        branching_probability: 0.35,
        max_order: 3,
        annual_extension_m: 0.6,
        max_penetration_mpa: 2.0,
        // Tolerates waterlogging poorly but keeps shallow roots there
        // [atlas_waterlogging] (estimated strengths).
        waterlogging_tolerance: 0.3,
        hypoxia_sensitivity: 0.3,
        hypoxia_air_porosity: 0.12,
        drought_deepening: 0.1,
        hydrotropism: 0.3,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.4,
        fine_root_per_m: 1200.0,
        rapid_taper: 1.5,
    ),
    tolerances: (
        // New shoots are sensitive to late frost (trait sheet, [wde_frost]
        // is winter hardiness, not modelled).
        frost_c: -3.0,
        // Little drought tolerance (shallow roots [atlas_drought]).
        drought: 0.2,
        // Shade tolerant (survives decades under cover [atlas_shade]).
        shade: 0.75,
    ),
    reproduction: (
        // 20-30 y open-grown (Atlas [atlas_first_flowering]); 30-40 in
        // Wikipedia de/sv; ~40 y in Britain [fr_coning].
        first_flowering_age_years: 28.0,
        // Red female strobili at the top of the crown in May-June
        // [wde_flowering], shown discreetly; pendent cones 12-15 cm
        // [atlas_cone_length], ripe in the same autumn, Sept-Oct
        // [wfr_cone_maturity].
        flower_display: 0.4,
        fruit_display: 1.0,
        bloom_gdd: 450.0,
        bloom_duration_gdd: 90.0,
        min_wood_age_years: 1,
        min_light: 0.45,
        max_wood_radius_mm: 15.0,
        flower_density: 0.8,
        flower_cluster_cm: 4.0,
        fruit_cluster_cm: 13.0,
        flower_color: (0.70, 0.18, 0.24),
        fruit_set: 0.6,
        flower_frost_c: -3.0,
        fruit_ripening_days: 125.0,
        // Cones hang after seed release (they fall in winter-spring; the
        // yearly cycle clears them on Dec 31).
        fruit_persistence_days: 70.0,
        fruit_color_unripe: (0.40, 0.42, 0.20),
        fruit_color_ripe: (0.47, 0.32, 0.18),
        fruit_kind: ConePendent,
        // Masting: flowering every 3-4 years (Wikipedia de; trait sheet),
        // good UK seed years every 5-10 [fr_coning].
        crop_interval_years: 3.5,
        off_year_crop: 0.1,
    ),
    // Normal lifespan 200-300 y [atlas_longevity_normal]; age decline is
    // estimated (the real causes are wind, beetles, rot).
    longevity: (
        decline_onset_years: 200.0,
        decline_years: 100.0,
        decline_min_vigour: 0.4,
        // Carbon balance of ageing (crates/dendro-core/src/vitality.rs):
        // maintenance of the living wood per metre of collar-to-leaf
        // distance, relative to the production of the same foliage.
        // Calibrated: no measured value exists; tuned (seeds 1-5) so that
        // the trunk dies, emergently, within the published longevity,
        // 200-300 y (Atlas) (data/validation/picea_abies.ron).
        // While > 0 the age-scheduled decline_* values above are ignored.
        maintenance_per_m: 0.0025,
    ),
    // Pinaceae are ectomycorrhizal (Wang & Qiu 2006, Mycorrhiza
    // 16:299-363); shares and costs: the oak's calibrations (estimated).
    symbiosis: (
        mycorrhiza: Ecto,
        carbon_cost: 0.15,
        phosphorus_share: 0.6,
        nitrogen_share: 0.4,
        water_share: 0.05,
        hyphal_reach_m: 0.35,
    ),
    // Pruning response (estimated, trait sheet): no stump sprouts, no
    // regrowth of cut branches, a lost top relayed by a whorl branch;
    // resinous wounds, poor compartmentalisation, rot enters by wounds.
    pruning: (
        epicormic_potential: 0.02,
        sprout_vigour: 0.5,
        stump_sprouting: 0.0,
        root_suckering: 0.0,
        compensatory_growth: 0.1,
        woundwood_ratio: 1.2,
        compartmentalization: 0.3,
        decay_infection_rate: 0.12,
        decay_axial_m_per_year: 0.15,
        decay_radial_mm_per_year: 6.0,
        pathogen_dormant_risk: 0.1,
        pathogen_summer_risk: 0.15,
        pathogen_dieback_years: 3.0,
        reserve_in_branches: 0.3,
        root_balance_rate: 0.3,
        sap_bleeding: 0.1,
        // 200-300 y [atlas_longevity_normal].
        typical_lifespan_years: 250.0,
    ),
    mechanics: (
        // 800 (700-850) kg/m3 (DIN 68364 via Wikipedia de [wdeholz_green]).
        green_density_kg_m3: 800.0,
        // No green MOR/MOE found for P. abies [wdeholz_bending] is dry:
        // red spruce proxy, USDA Wood Handbook FPL-GTR-190, Table 5-3a,
        // green: MOR 41 MPa, MOE 9.2 GPa.
        green_mor_mpa: 41.0,
        green_moe_gpa: 9.2,
        // Estimated (no conifer crown value read): as the broadleaves.
        crown_drag_coefficient: 0.2,
        vogel_exponent: -1.0,
        // ForestGALES Sitka spruce, freely draining, deep rooting (proxy;
        // the P. abies parameter set was not read).
        anchorage_nm_per_kg: 178.1,
    ),
    // Bark beetle (Ips typographus) mortality, crates/dendro-core/src/
    // vitality.rs (4.), docs/sources.md « Scolytes de l'épicéa ».
    biotic: (
        // Mean of the standing-dead spruce mortality of the Lower Saxony
        // forest condition survey in the bark-beetle years 2019 (6.1 %) and
        // 2020 (4.6 %), against 0-0.5 %/year from 1984 to 2018
        // [wzb_ni_2020_spruce_mortality_2019] [..._2020]
        // [..._1984_2018]. A lower bound of the beetle kill: trees removed
        // by sanitation felling count in the "Ausfallrate" (22.4 % of the
        // spruces in 2020, storm and insects, not split by cause).
        crisis_kill_rate: 0.0535,
        // Model choice: crisis years are seasons ending with reserves
        // <= 0.2, 3.0 % of the living years from 60 y on (20 seeds x 400 y,
        // examples/life_dist.rs, before this block), the closest of the
        // tested levels to the survey's 2 crisis years in 37 (5.4 %).
        crisis_reserve: 0.2,
        // Predisposition by stand age (Netherer et al. 2019, Table 4,
        // after Netherer & Nopp-Mayr 2005) [netherer2019_pas_age_*]:
        // < 60 y 0.2, 60-79 y 0.6, 80-100 y 0.9, > 100 y 1.0.
        age_weights: [(0.0, 0.2), (60.0, 0.6), (80.0, 0.9), (101.0, 1.0)],
    ),
)
