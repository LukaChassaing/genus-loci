// Common walnut, Juglans regia L. Fruit tree of the registry (category
// FruitTree: nut crop), derived from the Malus pilot for the file structure
// and calibrated on the walnut references.
//
// WHAT IS SIMULATED: an own-rooted seedling walnut ("franc", "noyer a bois",
// plein vent), never grafted. Fruit-orchard walnuts are grafted (Franquette,
// Lara; hybrid or black-walnut rootstocks): the VERGER greffe entries
// [ishs_franquette_budbreak] [ishs_g139_budbreak] [fr_wiki_grafted_*]
// [botu_*] [en_wiki_orchard_size] are not targets.
//
// ENGINE GAPS handled by approximation (to be reported, no code touched):
//  - compound imparipinnate leaf (5-9 leaflets, 20-45 cm [atlas_height]): one
//    long simple blade (lobes 0) stands for the whole leaf;
//  - heterodichogamous catkins / terminal female flowers: drawn as one
//    flower type;
//  - the taproot that fades with age is modelled by taproot_decline_years;
//  - juglone (allelopathy) [wsu_juglone] is not modelled.
//
// Values not backed by an entry carry the marker "proxy Malus domestica
// pilot, estimated". Reference values: data/validation/juglans_regia.ron (ids
// in brackets) and docs/species/juglans_regia.md.
(
    species: "Juglans regia",
    common_name: "Common walnut",
    common_name_fr: "Noyer commun",
    category: FruitTree, // proxy Malus domestica pilot, estimated
    architecture: (
        // Short trunk and a crown "larger than any other broadleaf" [atlas_height]:
        // a spreading, decurrent mature crown. Apical control estimated, no
        // Halle-Oldeman model found.
        apical_dominance_young: 0.66,
        apical_dominance_mature: 0.40,
        maturity_age_years: 45.0,
        juvenile_phase_years: 12.0,
        apical_dominance_branches: 0.5,
        lateral_competition: 1.8,
        // Calibrated: 25-35 m in a stand [atlas_height] [wal_height]; 15-25 m
        // solitary [de_wiki_height] [fr_wiki_height_solitary]; record 29 m [en_wiki_height_record].
        vigour_per_light: 6.5,
        bud_break_threshold: 1.0, // proxy Malus domestica pilot, estimated
        internode_length_m: 0.05,
        // Calibrated (stout shoots; annual shoot length not found).
        max_shoot_length_m: 0.85,
        lateral_buds_per_shoot: 5, // proxy Malus domestica pilot, estimated
        lateral_buds_per_metamer: 0.25,
        bud_lifetime_years: 4, // proxy Malus domestica pilot, estimated
        branching_angle_deg: 50.0,
        // Alternate compound leaves in a spiral (estimated).
        phyllotaxis_deg: 137.5,
        max_order: 120, // proxy Malus domestica pilot, estimated
        gravitropism: 0.6,
        lateral_gravitropism: 0.3, // proxy Malus domestica pilot, estimated
        limb_setpoint_low_deg: 70.0,
        limb_setpoint_high_deg: 50.0,
        twig_setpoint_deg: 70.0,
        // Very wide crown relative to the trunk [atlas_height]; 15 m wide in orchard
        // [en_wiki_orchard_size] (grafted: not a target). Calibrated.
        crown_spread_ratio: 1.4,
        phototropism: 0.12, // proxy Malus domestica pilot, estimated
        sinuosity_deg: 9.0, // proxy Malus domestica pilot, estimated
        leader_loss_probability: 0.06,
        leader_loss_angle_deg: 30.0, // proxy Malus domestica pilot, estimated
        sag_coefficient: 3.0,
        sag_min_radius_mm: 25.0, // proxy Malus domestica pilot, estimated
        sag_max_deg_per_year: 0.8, // proxy Malus domestica pilot, estimated
        sag_max_total_deg: 14.0, // proxy Malus domestica pilot, estimated
        sag_max_droop_deg: 15.0, // proxy Malus domestica pilot, estimated
        sag_min_inclination_deg: 45.0, // proxy Malus domestica pilot, estimated
        straightening_deg_per_year: 1.0, // proxy Malus domestica pilot, estimated
        straightening_keep_deg: 10.0, // proxy Malus domestica pilot, estimated
        straightening_min_radius_mm: 30.0, // proxy Malus domestica pilot, estimated
        // Very light-demanding, intolerant of lateral competition (trait sheet).
        shedding_threshold: 0.09,
        shade_survival_years: 2,
        shedding_mean_threshold: 0.0, // proxy Malus domestica pilot, estimated
        // Short trunk (trait sheet).
        clear_bole_fraction: 0.2,
        clear_bole_max_m: 3.5,
        clear_bole_limb_ratio: 0.5, // proxy Malus domestica pilot, estimated
        // Lifespan 100-200 y [atlas_longevity], 150-160 [fr_wiki_longevity], 200-300
        // [wal_longevity]: crown dieback from ~150 y (estimated).
        retrenchment_onset_years: 150.0,
        retrenchment_rate: 0.10, // proxy Malus domestica pilot, estimated
        retrenchment_ramp_years: 60.0,
        retrenchment_reach: 0.6, // proxy Malus domestica pilot, estimated
        epicormic_rate: 0.03, // proxy Malus domestica pilot, estimated
        // Height ceiling, calibrated on 25-35 m [atlas_height] / 25-30 m [wal_height].
        hydraulic_path_max_m: 30.0,
        // Height growth ends at 60-80 y [fr_wiki_height_stop]: a rapidly saturating
        // curve (calibrated).
        hydraulic_exponent: 1.6,
        hydraulic_foliage_exponent: 1.0,
    ),
    leaf: (
        // Estimated (large thin compound leaf).
        lma_g_m2: 55.0,
        // COMPOUND leaf approximated by one blade of the size of the whole leaf:
        // 5-9 leaflets, leaf 20-45 cm [atlas_height]; lobes 0 (engine gap).
        length_cm: 28.0,
        width_cm: 9.0,
        lobes: 0, // proxy Malus domestica pilot, estimated
        serration: 0.05,
        deciduous: true, // proxy Malus domestica pilot, estimated
        marcescence: 0.0, // proxy Malus domestica pilot, estimated
        marcescence_max_age_years: 1.0, // proxy Malus domestica pilot, estimated
        leaves_per_shoot: 6.0,
        cluster_size_leaves: 2.4,
        foliage_density: 2.5,
        tip_bunching: 0.2,
        petiole_ratio: 0.15,
        leaf_droop: 0.6,
        // No spur shoots (estimated).
        spur_foliage: 0.0,
        spur_max_radius_mm: 40.0, // proxy Malus domestica pilot, estimated
        spur_min_light: 0.1, // proxy Malus domestica pilot, estimated
        colour_spread: 0.5, // proxy Malus domestica pilot, estimated
    ),
    pigments: (
        chlorophyll: 1.0, // proxy Malus domestica pilot, estimated
        // Yellow-brown autumn colour, little red (calibrated by eye).
        carotenoids: 0.9,
        anthocyanins: 0.1,
        tannins: 0.5, // proxy Malus domestica pilot, estimated
        anthocyanin_persistence: 0.0, // proxy Malus domestica pilot, estimated
    ),
    phenology: (
        // Stratification of the seed 16-24 weeks at 3 degC [wal_stratification]
        // is a seed property; leaf chilling requirement not found: estimated.
        chilling_requirement_days: 70.0,
        chill_temp_min_c: -100.0, // proxy Malus domestica pilot, estimated
        chill_temp_max_c: 5.0, // proxy Malus domestica pilot, estimated
        gdd_base_c: 5.0, // proxy Malus domestica pilot, estimated
        // Calibrated: late budburst (leaf-on from mid-May, doy ~135 in Wallonia
        // [wal_leaf_on_start]; Franquette 5 May = doy 125 [ishs_franquette_budbreak] and G-139
        // 23 April, grafted cultivars: not targets; CNPF: very late [cnpf_late_budburst]).
        gdd_budburst: 430.0,
        chill_forcing_gdd: 250.0, // proxy Malus domestica pilot, estimated
        forcing_start_doy: 31, // proxy Malus domestica pilot, estimated
        chill_start_doy: 304, // proxy Malus domestica pilot, estimated
        leaf_expansion_gdd: 220.0,
        // Calibrated: leaf-on period ends mid-October (doy 288) [wal_leaf_on_end].
        senescence_photoperiod_h: 13.0,
        senescence_temp_base_c: 17.0, // proxy Malus domestica pilot, estimated
        senescence_cdd: 55.0,
        leaf_fall_days: 14.0,
    ),
    wood: (
        // Basic density 520 kg/m3 [wdb_walnut_basic] (640 at 12 % moisture
        // [wdb_walnut_density12], 550-700 [fr_wiki_density]).
        density_kg_m3: 520.0,
        // MOE 10.81 GPa [wdb_walnut_moe] (12 % moisture: not a green value).
        elasticity_gpa: 10.8,
        // Semi-ring-porous (trait sheet); the engine has a boolean: false
        // with a large earlywood share is the closest.
        ring_porous: false,
        earlywood_share: 0.5,
        ring_contrast: 0.4,
        // Calibrated: DBH up to 200 cm for old trees [atlas_dbh_max]; no free-standing
        // DBH-age table [absence_franc_dbh_age]: estimated shape.
        growth_coefficient: 0.00060,
        twig_radius_mm: 2.5, // proxy Malus domestica pilot, estimated
        max_ring_width_mm: 12.0,
        pipe_exponent: 2.2, // proxy Malus domestica pilot, estimated
        limb_draw_boost: 1.3, // proxy Malus domestica pilot, estimated
        bark_irregularity: 0.06, // proxy Malus domestica pilot, estimated
        adaptive_stress_mpa: 11.1, // proxy Malus domestica pilot, estimated
        adaptive_min_diameter_cm: 5.0, // proxy Malus domestica pilot, estimated
        adaptive_max_budget_share: 0.3, // proxy Malus domestica pilot, estimated
        collar_flare: 0.25, // proxy Malus domestica pilot, estimated
        root_flare: 0.3, // proxy Malus domestica pilot, estimated
        root_flare_height_radii: 1.5, // proxy Malus domestica pilot, estimated
        buttress_lobes: 0, // proxy Malus domestica pilot, estimated
        snag_years_per_m: 120.0, // proxy Malus domestica pilot, estimated
    ),
    bark: (
        // Light grey, smooth when young, deeply furrowed with age (estimated).
        color: (0.42, 0.38, 0.34),
        young_color: (0.55, 0.50, 0.44),
        old_darkening: (0.12, 0.10, 0.08), // proxy Malus domestica pilot, estimated
        lenticels: 0.3, // proxy Malus domestica pilot, estimated
        fissures: 0.7,
        gloss: 0.15, // proxy Malus domestica pilot, estimated
    ),
    roots: (
        // Strong taproot from youth that fades with age; 3-5 m deep, ambiguous
        // sentence [atlas_root] [wal_root_depth]. Decline age estimated.
        taproot_dominance: 0.85,
        taproot_decline_years: 30.0,
        max_depth_m: 4.0,
        lateral_spread: 1.5,
        lateral_count: 9, // proxy Malus domestica pilot, estimated
        lateral_depth_m: 0.4, // proxy Malus domestica pilot, estimated
        sinker_tendency: 0.3,
        branching_probability: 0.35, // proxy Malus domestica pilot, estimated
        max_order: 3, // proxy Malus domestica pilot, estimated
        annual_extension_m: 0.8, // proxy Malus domestica pilot, estimated
        // Very sensitive to soil compaction (trait sheet): estimated.
        max_penetration_mpa: 2.0,
        // Very sensitive to anoxia (trait sheet): estimated.
        waterlogging_tolerance: 0.15,
        hypoxia_sensitivity: 0.8,
        hypoxia_air_porosity: 0.12, // proxy Malus domestica pilot, estimated
        drought_deepening: 0.3, // proxy Malus domestica pilot, estimated
        hydrotropism: 0.4, // proxy Malus domestica pilot, estimated
        root_shoot_ratio: 0.25, // proxy Malus domestica pilot, estimated
        root_shoot_stress_gain: 0.5, // proxy Malus domestica pilot, estimated
        fine_root_per_m: 1000.0, // proxy Malus domestica pilot, estimated
        rapid_taper: 1.0, // proxy Malus domestica pilot, estimated
    ),
    tolerances: (
        // Young shoots sensitive to late frost (trait sheet: S to TS); young trees
        // -7 to -2 degC in early frost [wal_early_frost]; adults -30 degC [atlas_frost_old_trees]
        // (winter hardiness not modelled). Estimated.
        frost_c: -2.0,
        // Not very sensitive on a deep soil (trait sheet); >= 700 mm [wal_rain].
        drought: 0.5,
        // Very light-demanding (trait sheet).
        shade: 0.12,
    ),
    reproduction: (
        // Nut up to 18 g [atlas_nut_size] (informative).
        fruit_mass_g: 18.0,
        // Sources diverge: 15-20 y [wal_first_flowering], 10-20 y [de_wiki_first_fruit],
        // 7-8 y for ungrafted [plantvillage_seedling_vs_graft]; 12 y chosen (estimated,
        // lower end of the forest sources). Grafted 5-6 y [fr_wiki_grafted_first_fruit] is not a target.
        first_flowering_age_years: 12.0,
        // Male catkins and inconspicuous female flowers (stylised).
        flower_display: 0.6,
        fruit_display: 1.0, // proxy Malus domestica pilot, estimated
        // Flowers April-June [fr_wiki_flowering] (doy 91-151), with the leaves; calibrated.
        bloom_gdd: 500.0,
        bloom_duration_gdd: 150.0,
        min_wood_age_years: 1,
        min_light: 0.25, // proxy Malus domestica pilot, estimated
        max_wood_radius_mm: 30.0, // proxy Malus domestica pilot, estimated
        flower_density: 1.5,
        flower_cluster_cm: 8.0,
        // Nut 4-5 cm with its husk [atlas_nut_size].
        fruit_cluster_cm: 5.0,
        flower_color: (0.62, 0.68, 0.30),
        fruit_set: 0.3,
        // Young shoots and inflorescences sensitive to late frost (S to TS, trait sheet),
        // less than the black walnut; no threshold read: estimated.
        flower_frost_c: -2.0,
        // Estimated: nuts fall in September-October.
        fruit_ripening_days: 135.0,
        fruit_persistence_days: 30.0,
        fruit_color_unripe: (0.40, 0.55, 0.20),
        fruit_color_ripe: (0.45, 0.35, 0.18),
        fruit_kind: Nut,
        // Fruiting every 1-2 years [wal_fruiting_freq]: 2, with a high off-year crop.
        crop_interval_years: 2.0,
        off_year_crop: 0.5,
    ),
    longevity: (
        decline_onset_years: 140.0,
        decline_years: 80.0,
        decline_min_vigour: 0.3, // proxy Malus domestica pilot, estimated
    ),
    symbiosis: (
        // Juglans: arbuscular in general (Wang & Qiu 2006); Atlas silent
        // [absence_mycorrhiza_juglans].
        mycorrhiza: Arbuscular,
        carbon_cost: 0.10, // proxy Malus domestica pilot, estimated
        phosphorus_share: 0.7, // proxy Malus domestica pilot, estimated
        nitrogen_share: 0.2, // proxy Malus domestica pilot, estimated
        water_share: 0.03, // proxy Malus domestica pilot, estimated
        hyphal_reach_m: 0.12, // proxy Malus domestica pilot, estimated
    ),
    pruning: (
        epicormic_potential: 0.4,
        sprout_vigour: 1.6, // proxy Malus domestica pilot, estimated
        // Sprouts from the stump, especially when young [wal_stump].
        stump_sprouting: 0.6,
        root_suckering: 0.0,
        compensatory_growth: 0.35, // proxy Malus domestica pilot, estimated
        woundwood_ratio: 1.6, // proxy Malus domestica pilot, estimated
        compartmentalization: 0.5, // proxy Malus domestica pilot, estimated
        decay_infection_rate: 0.08, // proxy Malus domestica pilot, estimated
        decay_axial_m_per_year: 0.1, // proxy Malus domestica pilot, estimated
        decay_radial_mm_per_year: 6.0, // proxy Malus domestica pilot, estimated
        pathogen_dormant_risk: 0.25, // proxy Malus domestica pilot, estimated
        pathogen_summer_risk: 0.08, // proxy Malus domestica pilot, estimated
        pathogen_dieback_years: 3.0, // proxy Malus domestica pilot, estimated
        reserve_in_branches: 0.35, // proxy Malus domestica pilot, estimated
        root_balance_rate: 0.4, // proxy Malus domestica pilot, estimated
        // Does not like pruning: strong sap bleeding if cut outside late autumn
        // [fr_wiki_pruning] (Wikipedia claim).
        sap_bleeding: 0.9,
        // Sources diverge: 100-200 [atlas_longevity], 150-160 [fr_wiki_longevity],
        // 200-300 [wal_longevity]: 150-200 chosen as the common zone.
        typical_lifespan_years: 180.0,
    ),
    mechanics: (
        // Not found: estimated from basic density 520 with ~70 % moisture (dry mass).
        green_density_kg_m3: 900.0,
        // MOR 111.5 MPa and MOE 10.81 GPa are not green [wdb_walnut_mor]
        // [wdb_walnut_moe]: green estimated at ~0.6 x MOR and ~0.85 x MOE.
        green_mor_mpa: 67.0,
        green_moe_gpa: 9.2,
        crown_drag_coefficient: 0.2, // proxy Malus domestica pilot, estimated
        vogel_exponent: -1.0, // proxy Malus domestica pilot, estimated
        anchorage_nm_per_kg: 178.1, // proxy Malus domestica pilot, estimated
    ),
)

