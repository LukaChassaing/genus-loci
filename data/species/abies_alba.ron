// Silver fir, Abies alba Mill. Started from the Norway spruce pilot
// (picea_abies.ron: evergreen needle cohorts, annual whorls, plagiotropic
// branches). Reference values: data/validation/abies_alba.ron (ids in
// brackets) and the trait sheet docs/species/abies_alba.md. Status of each
// value: "measured" (a published value read by the research agent), "proxy"
// (another species), "estimated" (general knowledge, no source read),
// "calibrated" (tuned so the emergent tree matches the references).
// No age-height-DBH table of OPEN-GROWN silver fir was found (trait sheet,
// "Non trouvé"). Calibration targets: usual adult height 30-50 m
// [wde_height] [wen_height] and trunk ~1.5 m [wen_dbh] read by the bench at
// its "adult" age (0.6 x typical_lifespan_years = 300 y). The stand values
// (30 m at 100 y [utschig_h100], 4-5 m below spruce at equal age
// [utschig_gap]) are stand heights, used only as a sanity check: an
// open-grown tree is not a stand tree. Slow youth, late culmination
// (Utschig 2004, trait sheet).
(
    species: "Abies alba",
    common_name: "Silver fir",
    common_name_fr: "Sapin pectiné",
    category: Conifer,
    architecture: (
        // Monopodial, very straight stem with strong apical control (trait
        // sheet); the old crown flattens into a rounded dome ("stork's
        // nest", Atlas quoted in the trait sheet): the stem's dominance
        // falls late in life (calibrated, by eye on the probe).
        apical_dominance_young: 0.80,
        apical_dominance_mature: 0.66,
        maturity_age_years: 220.0,
        juvenile_phase_years: 90.0,
        apical_dominance_branches: 0.62,
        lateral_competition: 1.4,
        // Calibrated: slower youth than the spruce (trait sheet; no fir
        // leader-growth value was found, estimated): ~34 m at 100 y, about
        // 3 m below the spruce pilot (stands: 4-5 m [utschig_gap]).
        vigour_per_light: 5.0,
        bud_break_threshold: 1.0,
        internode_length_m: 0.04,
        max_shoot_length_m: 0.50,
        // One whorl per annual shoot (Abies, guide: verticilles annuels);
        // count per whorl estimated as the spruce.
        lateral_buds_per_shoot: 5,
        lateral_buds_per_metamer: 0.4,
        bud_lifetime_years: 3,
        whorled: true,
        // Flat, pectinate sprays (Massart's model for some Abies, trait
        // sheet "non vérifié"): more planar than the spruce (estimated).
        lateral_planarity: 0.65,
        branching_angle_deg: 75.0,
        phyllotaxis_deg: 137.5,
        max_order: 8,
        // Branches more horizontal than the spruce's, less drooping
        // (estimated, set by eye).
        gravitropism: 1.0,
        lateral_gravitropism: 0.35,
        limb_setpoint_low_deg: 92.0,
        limb_setpoint_high_deg: 65.0,
        twig_setpoint_deg: 90.0,
        // Conical crown (calibrated: W/H ~0.3 at 100 y). Once the height
        // levels off the old crown keeps widening (~0.47 at 300 y, the
        // spruce pilot reaches ~0.59): the rounded dome is emergent.
        crown_spread_ratio: 0.35,
        phototropism: 0.05,
        sinuosity_deg: 2.0,
        leader_loss_probability: 0.02,
        leader_loss_angle_deg: 15.0,
        sag_coefficient: 4.0,
        sag_min_radius_mm: 20.0,
        sag_max_deg_per_year: 0.6,
        sag_max_total_deg: 15.0,
        sag_max_droop_deg: 25.0,
        sag_min_inclination_deg: 50.0,
        straightening_deg_per_year: 2.0,
        straightening_keep_deg: 5.0,
        straightening_min_radius_mm: 25.0,
        // Extremely shade tolerant [wde_shade]: shaded branches live long
        // (estimated strengths, lower than the spruce's).
        shedding_threshold: 0.03,
        shade_survival_years: 7,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.05,
        clear_bole_max_m: 1.0,
        clear_bole_limb_ratio: 0.3,
        retrenchment_onset_years: 0.0,
        retrenchment_rate: 0.0,
        retrenchment_ramp_years: 100.0,
        retrenchment_reach: 1.0,
        // Epicormic shoots on > 50 % of firs in dense stands
        // [utschig_epicormic]; a low reiteration rate (calibrated guess).
        epicormic_rate: 0.01,
        // Calibrated on the 30-50 m adult height [wde_height] [wen_height];
        // a higher exponent keeps the curve rising late (late culmination,
        // trait sheet).
        hydraulic_path_max_m: 48.0,
        hydraulic_exponent: 1.3,
        hydraulic_foliage_exponent: 0.8,
    ),
    leaf: (
        // Flat needles 1.5-3 cm [wfr_needle_length] [wen_needle_length].
        length_cm: 2.4,
        width_cm: 0.25,
        lobes: 0,
        serration: 0.0,
        deciduous: false,
        marcescence: 0.0,
        marcescence_max_age_years: 1.0,
        leaf_type: Needle,
        // 6-8 years [atlas_needle_longevity] [wfr_needle_longevity] against
        // 8-12 [wde_needle_longevity]: 8, the common bound.
        leaf_longevity_years: 8.0,
        // Not found (trait sheet): the spruce's values (proxy).
        lma_g_m2: 200.0,
        crown_lai: 4.0,
        // Rendering: pectinate needles held at right angles to the twig.
        leaves_per_shoot: 60.0,
        cluster_size_leaves: 8.0,
        foliage_density: 2.6,
        tip_bunching: 0.0,
        petiole_ratio: 0.0,
        leaf_droop: 0.9,
        spur_foliage: 0.0,
        spur_max_radius_mm: 15.0,
        spur_min_light: 0.1,
        colour_spread: 0.3,
    ),
    // Calibration by eye: dark glossy green.
    pigments: (
        chlorophyll: 1.35,
        carotenoids: 0.5,
        anthocyanins: 0.0,
        tannins: 0.5,
        anthocyanin_persistence: 0.0,
    ),
    phenology: (
        // Early budburst, hence exposed to late frosts [atlas_frost] (trait
        // sheet); no day of year found: estimated about a week before the
        // spruce pilot (calibrated against picea_abies, 420).
        chilling_requirement_days: 50.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 340.0,
        chill_forcing_gdd: 300.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 300.0,
        // Ring closure and cast of the oldest cohort (estimated, as the
        // spruce).
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 16.0,
        senescence_cdd: 150.0,
        leaf_fall_days: 40.0,
    ),
    wood: (
        // Basic specific gravity 0.32 (Wood Database [wdb_density] site
        // field): 320 kg/m3.
        density_kg_m3: 320.0,
        // Green MOE: as the spruce genome (proxy, red spruce green value);
        // no green value found for A. alba (trait sheet).
        elasticity_gpa: 9.2,
        ring_porous: false,
        earlywood_share: 0.7,
        ring_contrast: 0.55,
        // Calibrated: ~1.6 m at 300 y, between ~1.5 m [wen_dbh] and 2 m
        // [wfr_dbh] [wde_dbh]. The engine never kills the tree: the DBH
        // keeps rising to ~2 m at 400 y.
        growth_coefficient: 0.000420,
        twig_radius_mm: 2.0,
        max_ring_width_mm: 10.0,
        pipe_exponent: 2.0,
        limb_draw_boost: 1.1,
        bark_irregularity: 0.01,
        adaptive_stress_mpa: 11.1,
        adaptive_min_diameter_cm: 5.0,
        adaptive_max_budget_share: 0.3,
        collar_flare: 0.12,
        // Taprooted (trait sheet): less flared collar than the spruce
        // (estimated).
        root_flare: 0.3,
        root_flare_height_radii: 1.2,
        buttress_lobes: 4,
        snag_years_per_m: 250.0,
    ),
    // Smooth silver-grey bark, cracking into small plates when old
    // (estimated).
    bark: (
        color: (0.52, 0.52, 0.50),
        young_color: (0.58, 0.58, 0.55),
        old_darkening: (0.12, 0.12, 0.11),
        lenticels: 0.1,
        fissures: 0.2,
        gloss: 0.08,
    ),
    roots: (
        // Deep taproot: ~1.5 m in Germany, near 3 m in warm Austria
        // [wde_taproot]; "tiefreichende Pfahlwurzel" [utschig_taproot].
        // Taproot strength and soil penetration calibrated so the taproot
        // goes past 1.5 m on the reference loam (estimated strengths).
        taproot_dominance: 0.8,
        taproot_decline_years: 30.0,
        max_depth_m: 2.5,
        lateral_spread: 1.5,
        lateral_count: 10,
        lateral_depth_m: 0.35,
        sinker_tendency: 0.25,
        branching_probability: 0.35,
        max_order: 3,
        annual_extension_m: 0.7,
        max_penetration_mpa: 3.2,
        // Intolerant of compact and hydromorphic soils [atlas_waterlogging]
        // (estimated strengths).
        waterlogging_tolerance: 0.2,
        hypoxia_sensitivity: 0.35,
        hypoxia_air_porosity: 0.12,
        drought_deepening: 0.2,
        hydrotropism: 0.3,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.4,
        fine_root_per_m: 1200.0,
        rapid_taper: 1.5,
    ),
    tolerances: (
        // Late frosts damage the early shoots [atlas_frost] (estimated
        // threshold, slightly more sensitive than the spruce).
        frost_c: -2.5,
        // Needs 700-1800 mm and cool summers [atlas_precip]
        // [atlas_summer_temp]: little drought tolerance (estimated).
        drought: 0.2,
        // Extremely shade tolerant [wde_shade].
        shade: 0.9,
    ),
    reproduction: (
        // 25-35 y open-grown [wde_first_flowering_open]; 30-40 [atlas_first_flowering].
        first_flowering_age_years: 30.0,
        // Flowering April-May [atlas_flowering] [wfr_flowering]; erect cones
        // 9-20 cm [wen_cone_length] [wfr_cone_length] [wde_cone_length],
        // ripe the same autumn (trait sheet, estimated). The cones
        // disintegrate on the tree (engine gap: drawn as an erect cone that
        // vanishes after a short persistence).
        flower_display: 0.3,
        fruit_display: 1.0,
        bloom_gdd: 380.0,
        bloom_duration_gdd: 90.0,
        min_wood_age_years: 1,
        min_light: 0.5,
        max_wood_radius_mm: 15.0,
        flower_density: 0.8,
        flower_cluster_cm: 3.0,
        fruit_cluster_cm: 14.0,
        flower_color: (0.45, 0.55, 0.25),
        fruit_set: 0.6,
        flower_frost_c: -2.5,
        fruit_ripening_days: 130.0,
        fruit_persistence_days: 25.0,
        fruit_color_unripe: (0.35, 0.40, 0.22),
        fruit_color_ripe: (0.45, 0.33, 0.20),
        fruit_kind: ConeErect,
        // No masting interval found for A. alba (trait sheet): as the
        // spruce (estimated).
        crop_interval_years: 3.0,
        off_year_crop: 0.1,
    ),
    // 500-600 y [atlas_longevity]; decline estimated.
    longevity: (
        decline_onset_years: 350.0,
        decline_years: 150.0,
        decline_min_vigour: 0.4,
        // Carbon balance of ageing (crates/dendro-core/src/vitality.rs):
        // maintenance of the living wood per metre of collar-to-leaf
        // distance, relative to the production of the same foliage.
        // Calibrated: no measured value exists; tuned (seeds 1-5) so that
        // the trunk dies, emergently, within the published longevity,
        // 500-600 y (Atlas): beyond the 400-year bench run (data/validation/abies_alba.ron).
        // Set low enough that the cost stays below ~75 % of production
        // within 400 years (only censored runs can be checked).
        // While > 0 the age-scheduled decline_* values above are ignored.
        maintenance_per_m: 0.0006,
    ),
    // Pinaceae: ectomycorrhizal (guide, Wang & Qiu 2006; trait sheet
    // "estimé"); shares as the spruce (estimated).
    symbiosis: (
        mycorrhiza: Ecto,
        carbon_cost: 0.15,
        phosphorus_share: 0.6,
        nitrogen_share: 0.4,
        water_share: 0.05,
        hyphal_reach_m: 0.35,
    ),
    // No stump sprouts, no regrowth after topping (trait sheet, estimated),
    // but epicormic shoots on the stem [utschig_epicormic].
    pruning: (
        epicormic_potential: 0.25,
        sprout_vigour: 0.5,
        stump_sprouting: 0.0,
        root_suckering: 0.0,
        compensatory_growth: 0.15,
        woundwood_ratio: 1.2,
        compartmentalization: 0.35,
        decay_infection_rate: 0.12,
        decay_axial_m_per_year: 0.15,
        decay_radial_mm_per_year: 6.0,
        pathogen_dormant_risk: 0.1,
        pathogen_summer_risk: 0.15,
        pathogen_dieback_years: 3.0,
        reserve_in_branches: 0.3,
        root_balance_rate: 0.3,
        sap_bleeding: 0.05,
        // 500-600 y [atlas_longevity], > 500 [wde_longevity].
        typical_lifespan_years: 500.0,
    ),
    mechanics: (
        // No green values found for A. alba (trait sheet): the spruce
        // genome's (proxy: 800 kg/m3 green; red spruce green MOR/MOE).
        green_density_kg_m3: 800.0,
        green_mor_mpa: 41.0,
        green_moe_gpa: 9.2,
        crown_drag_coefficient: 0.2,
        vogel_exponent: -1.0,
        // Not parameterised in ForestGALES (trait sheet): the spruce
        // genome's Sitka value (proxy); the deep taproot is not credited.
        anchorage_nm_per_kg: 178.1,
    ),
)
