// European yew, Taxus baccata L. Started from the Norway spruce pilot
// (picea_abies.ron) for the evergreen needle cohorts, with the whorls,
// cones and ectomycorrhizae removed. Reference values:
// data/validation/taxus_baccata.ron (ids in brackets) and the trait sheet
// docs/species/taxus_baccata.md. Status of each value: "measured" (a
// published value read by the research agent), "proxy" (another species),
// "estimated" (general knowledge, no source read), "calibrated" (tuned so
// the emergent tree matches the references).
// The yew is apart: an aril instead of a cone, no resin, DIOECIOUS (engine
// gap: every simulated tree flowers and fruits; a male tree would bear no
// arils), arbuscular mycorrhizae, stump sprouting and reiteration, very
// slow growth (~4.5 m at 20 y [wen_growth], up to 20 cm/yr [wde_height_growth]),
// height growth almost stopped after ~100 y. Often multi-stemmed (engine
// gap: one trunk is simulated). The huge DBH of very old yews (2-4 m
// [wen_dbh] [atlas_dbh]) comes from fused stems over many centuries and
// hollow trunks (heart rot from ~250 y [wde_heartrot], not modelled).
(
    species: "Taxus baccata",
    common_name: "European yew",
    common_name_fr: "If commun",
    category: Conifer,
    architecture: (
        // Small tree with a broad dense crown, irregular branching, no
        // whorls (trait sheet). Excurrent youth kept for the single
        // simulated trunk (guide: fork below 1.3 m), decurrent adult
        // (calibrated by eye).
        apical_dominance_young: 0.66,
        apical_dominance_mature: 0.45,
        maturity_age_years: 80.0,
        juvenile_phase_years: 15.0,
        apical_dominance_branches: 0.52,
        lateral_competition: 1.4,
        // Calibrated with max_shoot_length_m below: ~3.8 m at 20 y against
        // 4.5 m [wen_growth]. The two sources are not compatible (4.5 m in
        // 20 y needs 22.5 cm/yr on average, above the 20 cm/yr maximum):
        // the measured maximum shoot is kept.
        vigour_per_light: 5.0,
        bud_break_threshold: 1.0,
        internode_length_m: 0.04,
        // Up to 20 cm/yr in good conditions [wde_height_growth]. Node count
        // limited (internode, order, buds, shedding below) to keep a
        // 400-year bench run tractable: a shade-tolerant crown keeps almost
        // every shoot (~30 000 nodes at 100 y).
        max_shoot_length_m: 0.20,
        lateral_buds_per_shoot: 4,
        lateral_buds_per_metamer: 0.3,
        bud_lifetime_years: 4,
        whorled: false,
        // Needles in two ranks on flat sprays (trait sheet).
        lateral_planarity: 0.5,
        branching_angle_deg: 55.0,
        phyllotaxis_deg: 137.5,
        max_order: 6,
        gravitropism: 0.6,
        lateral_gravitropism: 0.3,
        limb_setpoint_low_deg: 75.0,
        limb_setpoint_high_deg: 45.0,
        twig_setpoint_deg: 85.0,
        // Broad dense crown (calibrated by eye).
        crown_spread_ratio: 0.6,
        phototropism: 0.1,
        sinuosity_deg: 6.0,
        leader_loss_probability: 0.06,
        leader_loss_angle_deg: 20.0,
        sag_coefficient: 4.0,
        sag_min_radius_mm: 20.0,
        sag_max_deg_per_year: 0.6,
        sag_max_total_deg: 15.0,
        sag_max_droop_deg: 25.0,
        sag_min_inclination_deg: 50.0,
        straightening_deg_per_year: 2.0,
        straightening_keep_deg: 5.0,
        straightening_min_radius_mm: 25.0,
        // The most shade-tolerant European tree, compensation point ~300
        // lux [atlas_shade] [wde_light]: shaded branches live very long
        // (estimated strengths).
        shedding_threshold: 0.05,
        shade_survival_years: 6,
        shedding_mean_threshold: 0.0,
        clear_bole_fraction: 0.05,
        clear_bole_max_m: 1.0,
        clear_bole_limb_ratio: 0.3,
        retrenchment_onset_years: 0.0,
        retrenchment_rate: 0.0,
        retrenchment_ramp_years: 100.0,
        retrenchment_reach: 1.0,
        // Reiteration from latent buds of old wood and trunk (trait sheet):
        // a steady epicormic rate (calibrated guess).
        epicormic_rate: 0.01,
        // Calibrated: 10-20 m [wen_height], rarely > 15 m in central
        // Europe [wde_height]; growth almost stops after ~100 y
        // [wen_growth].
        hydraulic_path_max_m: 16.0,
        hydraulic_exponent: 1.4,
        hydraulic_foliage_exponent: 0.7,
    ),
    leaf: (
        // Flat needles 2-3 cm [atlas_needle_length], 1.5-3.5 [wde_needle_length].
        length_cm: 2.6,
        width_cm: 0.25,
        lobes: 0,
        serration: 0.0,
        deciduous: false,
        marcescence: 0.0,
        marcescence_max_age_years: 1.0,
        leaf_type: Needle,
        // 3-8 years [wde_needle_longevity].
        leaf_longevity_years: 6.0,
        // Not found (trait sheet): the spruce's values (proxy).
        lma_g_m2: 200.0,
        crown_lai: 4.0,
        leaves_per_shoot: 40.0,
        cluster_size_leaves: 6.0,
        foliage_density: 2.8,
        tip_bunching: 0.0,
        petiole_ratio: 0.0,
        leaf_droop: 0.9,
        spur_foliage: 0.0,
        spur_max_radius_mm: 15.0,
        spur_min_light: 0.1,
        colour_spread: 0.3,
    ),
    // Calibration by eye: very dark glossy green.
    pigments: (
        chlorophyll: 1.5,
        carotenoids: 0.4,
        anthocyanins: 0.0,
        tannins: 0.5,
        anthocyanin_persistence: 0.0,
    ),
    phenology: (
        // No budburst date found (trait sheet): estimated as the fir
        // genome.
        chilling_requirement_days: 50.0,
        chill_temp_min_c: -100.0,
        chill_temp_max_c: 5.0,
        gdd_base_c: 5.0,
        gdd_budburst: 340.0,
        chill_forcing_gdd: 300.0,
        forcing_start_doy: 31,
        chill_start_doy: 304,
        leaf_expansion_gdd: 300.0,
        senescence_photoperiod_h: 12.0,
        senescence_temp_base_c: 16.0,
        senescence_cdd: 150.0,
        leaf_fall_days: 40.0,
    ),
    wood: (
        // Basic specific gravity 0.55 (Wood Database [wdb_density] site
        // field): 550 kg/m3.
        density_kg_m3: 550.0,
        // Green MOE: as the spruce genome (proxy); no green value found.
        elasticity_gpa: 9.2,
        ring_porous: false,
        earlywood_share: 0.6,
        ring_contrast: 0.5,
        // Calibrated (slow, fine rings, trait sheet): ~0.95 m at 360 y. The
        // 2-4 m trunks of veteran yews [wen_dbh] [atlas_dbh] are fused
        // multi-stems many centuries old: not reached (engine gap).
        growth_coefficient: 0.000400,
        twig_radius_mm: 1.8,
        max_ring_width_mm: 6.0,
        pipe_exponent: 2.0,
        limb_draw_boost: 1.2,
        // Fluted trunk (trait sheet).
        bark_irregularity: 0.06,
        adaptive_stress_mpa: 11.1,
        adaptive_min_diameter_cm: 5.0,
        adaptive_max_budget_share: 0.3,
        collar_flare: 0.2,
        root_flare: 0.45,
        root_flare_height_radii: 1.5,
        buttress_lobes: 6,
        // Very durable heartwood [wdb_density] (trait sheet).
        snag_years_per_m: 500.0,
    ),
    // Thin, reddish-brown bark flaking in scales (estimated).
    bark: (
        color: (0.48, 0.28, 0.22),
        young_color: (0.55, 0.32, 0.24),
        old_darkening: (0.12, 0.08, 0.07),
        lenticels: 0.0,
        fissures: 0.15,
        gloss: 0.08,
    ),
    roots: (
        // Divergent sources: shallow with extensive horizontal roots
        // [atlas_root] against "very extensive, deep and dense"
        // [wde_roots]; penetrates rock crevices. Moderate depth, wide
        // spread (estimated).
        taproot_dominance: 0.4,
        taproot_decline_years: 15.0,
        max_depth_m: 1.5,
        lateral_spread: 1.6,
        lateral_count: 12,
        lateral_depth_m: 0.25,
        sinker_tendency: 0.15,
        branching_probability: 0.4,
        max_order: 3,
        annual_extension_m: 0.4,
        max_penetration_mpa: 3.0,
        // Susceptible to long-term poor drainage [atlas_waterlogging]
        // (estimated strengths).
        waterlogging_tolerance: 0.2,
        hypoxia_sensitivity: 0.4,
        hypoxia_air_porosity: 0.12,
        drought_deepening: 0.2,
        hydrotropism: 0.3,
        root_shoot_ratio: 0.25,
        root_shoot_stress_gain: 0.4,
        fine_root_per_m: 1300.0,
        rapid_taper: 1.5,
    ),
    tolerances: (
        // Prefers a mild oceanic climate (Atlas, trait sheet); new shoots:
        // estimated.
        frost_c: -3.0,
        // Moderately drought tolerant [atlas_drought].
        drought: 0.45,
        // Extremely shade tolerant [atlas_shade] [wde_light].
        shade: 0.95,
    ),
    reproduction: (
        // 15-30 y in good light [wde_first_flowering_opt].
        first_flowering_age_years: 20.0,
        // Wind pollination February-March [wde_flowering]; arils mature
        // 6-9 months later [wen_aril], seeds ripe August-October
        // [wde_seed]; aril ~0.7 cm [atlas_aril], red (the only non-toxic
        // part). Aril drawn as a round fruit (engine gap). Dioecy not
        // modelled (engine gap).
        flower_display: 0.2,
        fruit_display: 1.0,
        bloom_gdd: 30.0,
        bloom_duration_gdd: 40.0,
        min_wood_age_years: 1,
        min_light: 0.2,
        max_wood_radius_mm: 10.0,
        flower_density: 0.8,
        flower_cluster_cm: 1.0,
        fruit_cluster_cm: 1.2,
        flower_color: (0.85, 0.80, 0.45),
        fruit_set: 0.6,
        flower_frost_c: -5.0,
        fruit_ripening_days: 180.0,
        fruit_persistence_days: 45.0,
        fruit_color_unripe: (0.35, 0.50, 0.25),
        fruit_color_ripe: (0.85, 0.12, 0.15),
        fruit_kind: Aril,
        // No interval found: fruiting most years (estimated).
        crop_interval_years: 1.5,
        off_year_crop: 0.4,
    ),
    // Very long-lived: > 600 y often overestimated [wen_longevity]; decline
    // estimated.
    longevity: (
        decline_onset_years: 400.0,
        decline_years: 300.0,
        decline_min_vigour: 0.5,
        // Carbon balance of ageing (crates/dendro-core/src/vitality.rs):
        // maintenance of the living wood per metre of collar-to-leaf
        // distance, relative to the production of the same foliage.
        // Calibrated: no measured value exists; tuned (seeds 1-5) so that
        // the trunk dies, emergently, within the published longevity,
        // 600 to several thousand years: far beyond the 400-year bench run (data/validation/taxus_baccata.ron).
        // Set low enough that the cost stays below ~75 % of production
        // within 400 years (only censored runs can be checked).
        // While > 0 the age-scheduled decline_* values above are ignored.
        maintenance_per_m: 0.0006,
    ),
    // Arbuscular mycorrhiza, unlike the other conifers [wde_mycorrhiza];
    // shares as the other genomes (estimated).
    symbiosis: (
        mycorrhiza: Arbuscular,
        carbon_cost: 0.12,
        phosphorus_share: 0.6,
        nitrogen_share: 0.3,
        water_share: 0.05,
        hyphal_reach_m: 0.1,
    ),
    // Tolerates repeated pruning [atlas_pruning]; the only European conifer
    // that resprouts from the stump [wde_resprout]; reiteration from latent
    // buds (trait sheet). Strengths estimated.
    pruning: (
        epicormic_potential: 0.8,
        sprout_vigour: 0.8,
        stump_sprouting: 0.8,
        root_suckering: 0.0,
        compensatory_growth: 0.5,
        woundwood_ratio: 1.2,
        compartmentalization: 0.6,
        decay_infection_rate: 0.08,
        decay_axial_m_per_year: 0.08,
        decay_radial_mm_per_year: 3.0,
        pathogen_dormant_risk: 0.05,
        pathogen_summer_risk: 0.08,
        pathogen_dieback_years: 3.0,
        reserve_in_branches: 0.4,
        root_balance_rate: 0.4,
        sap_bleeding: 0.0,
        // ~600 y [wen_longevity] (5000 reported [atlas_longevity], 1000+
        // [wfr_longevity], unverifiable).
        typical_lifespan_years: 600.0,
    ),
    mechanics: (
        // No green values found (trait sheet): the spruce genome's (proxy;
        // yew wood is much denser and stronger, see [wdb_mor]).
        green_density_kg_m3: 800.0,
        green_mor_mpa: 41.0,
        green_moe_gpa: 9.2,
        crown_drag_coefficient: 0.2,
        vogel_exponent: -1.0,
        // No data (trait sheet): the spruce genome's Sitka value (proxy).
        anchorage_nm_per_kg: 178.1,
    ),
)
